def entropy_lambda(step: int, total_steps: int, lam_max: float, lam_min: float) -> float:
    if total_steps <= 1:
        return lam_min
    frac = min(max(step / float(total_steps - 1), 0.0), 1.0)
    return lam_max * ((lam_min / lam_max) ** frac)


def anneal_value(step: int, total_steps: int, value_max: float, value_min: float) -> float:
    if total_steps <= 1:
        return value_min
    frac = min(max(step / float(total_steps - 1), 0.0), 1.0)
    if value_max <= 0.0 or value_min <= 0.0:
        return value_max + frac * (value_min - value_max)
    return value_max * ((value_min / value_max) ** frac)


def metric_curriculum_weights(
    step: int,
    residual_until: int,
    ber_only_from: int,
    residual_floor: float = 0.1,
) -> Tuple[float, float]:
    """Return the globally shared residual/BER metric weights for one step.

    Before ``residual_until`` every optimized decision uses residual energy.
    Between the boundaries the metric linearly transitions to true-bit BCE.
    From ``ber_only_from`` onward the supervised BER-aware term dominates while
    residual energy retains ``residual_floor`` weight.
    """
    residual_until = max(0, int(residual_until))
    ber_only_from = max(residual_until + 1, int(ber_only_from))
    residual_floor = min(max(float(residual_floor), 0.0), 1.0)
    if step <= residual_until:
        return 1.0, 0.0
    if step >= ber_only_from:
        return residual_floor, 1.0 - residual_floor
    transition = (step - residual_until) / float(ber_only_from - residual_until)
    residual_weight = 1.0 - transition * (1.0 - residual_floor)
    return residual_weight, 1.0 - residual_weight


def soft_binary_cross_entropy(probs: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:
    probs = probs.clamp(1e-5, 1.0 - 1e-5)
    targets = targets.to(dtype=probs.dtype)
    return -(targets * torch.log(probs) + (1.0 - targets) * torch.log(1.0 - probs)).mean()


def candidate_logprob_per_bit(bits: torch.Tensor, probs: torch.Tensor) -> torch.Tensor:
    """Average per-bit log probability assigned to hard candidate bits.

    bits/probs: (B, K, Nt, 8). Returns (B, K). Less negative is better.
    """
    probs = probs.clamp(1e-5, 1.0 - 1e-5)
    logp = bits.float() * torch.log(probs) + (1.0 - bits.float()) * torch.log(1.0 - probs)
    return logp.mean(dim=(-1, -2))


def per_candidate_true_bce(probs: torch.Tensor, true_bits: torch.Tensor) -> torch.Tensor:
    """Per-candidate bit BCE to the known transmitted bits.

    probs: (B, K, Nt, BITS_PER_SYMBOL)
    true_bits: (B, Nt, BITS_PER_SYMBOL)
    returns: (B, K), lower means more BER-aligned with the supervised target.
    """
    probs = probs.clamp(1e-5, 1.0 - 1e-5)
    target = true_bits[:, None, :, :].to(dtype=probs.dtype).expand_as(probs)
    ce = -(target * torch.log(probs) + (1.0 - target) * torch.log(1.0 - probs))
    return ce.mean(dim=(-1, -2))


def normalize_positive_metric(metric: torch.Tensor, eps: float = 1e-6) -> torch.Tensor:
    """Batch-wise proportional scaling so heterogeneous costs have comparable weight."""
    scale = metric.detach().mean().abs().clamp_min(eps)
    return metric / scale


def zscore_candidates(values: torch.Tensor, eps: float = 1e-6) -> torch.Tensor:
    """Normalize a (B,K) score within each channel instance."""
    if values.shape[1] <= 1:
        return torch.zeros_like(values)
    centered = values - values.mean(dim=1, keepdim=True)
    return centered / (values.std(dim=1, keepdim=True, unbiased=False).clamp_min(eps))


def aggregate_k_candidate_posteriors(
    candidate_bits: torch.Tensor,
    candidate_probs: torch.Tensor,
    H: torch.Tensor,
    y: torch.Tensor,
    sigma2: float,
    residual_tau: float = 0.25,
    confidence_coef: Optional[torch.Tensor] = None,
    residual_coef: Optional[torch.Tensor] = None,
) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    """Aggregate K neural candidates into one bit-wise posterior without labels/list-MAP.

    Candidate weights are driven primarily by model self-confidence and mildly
    calibrated by residual energy. The final hard output is a bit-wise decision,
    which is better aligned with BER than selecting one whole candidate vector.
    """
    confidence = candidate_logprob_per_bit(candidate_bits, candidate_probs)
    energy = residual_energy(candidate_bits, H, y, sigma2)
    if confidence_coef is None:
        confidence_weight = candidate_probs.new_tensor(1.0)
    else:
        confidence_weight = F.softplus(confidence_coef.to(device=candidate_probs.device, dtype=candidate_probs.dtype))
    if residual_coef is None:
        residual_weight = candidate_probs.new_tensor(float(residual_tau))
    else:
        residual_weight = F.softplus(residual_coef.to(device=candidate_probs.device, dtype=candidate_probs.dtype))
    weight_logits = confidence_weight * zscore_candidates(confidence) - residual_weight * zscore_candidates(energy)
    weights = torch.softmax(weight_logits, dim=1)
    posterior = (weights[..., None, None] * candidate_probs.clamp(1e-5, 1.0 - 1e-5)).sum(dim=1)
    hard_bits = (posterior >= 0.5).float()
    return hard_bits, posterior, weights


@torch.no_grad()
def select_final_bits(
    model: DynamicGraphContextL2ATransformer,
    candidate_bits: torch.Tensor,
    candidate_probs: torch.Tensor,
    H: torch.Tensor,
    y: torch.Tensor,
    true_bits: torch.Tensor,
    sigma2: float,
    mode: str,
    residual_consensus_m: int = 5,
) -> torch.Tensor:
    """Select or aggregate K post-LS candidates for fixed-test reporting."""
    mode_key = mode.lower()
    if mode_key == "ave":
        return (candidate_bits.float().mean(dim=1) >= 0.5).float()
    if mode_key == "best":
        selection_score = residual_energy(candidate_bits, H, y, sigma2)
        best_idx = selection_score.argmin(dim=1)
        return candidate_bits[torch.arange(candidate_bits.shape[0], device=candidate_bits.device), best_idx]
    if mode_key == "merge":
        hard_bits, _posterior, _weights = aggregate_k_candidate_posteriors(
            candidate_bits,
            candidate_probs,
            H,
            y,
            sigma2,
            confidence_coef=model.merge_confidence_logit,
            residual_coef=model.merge_residual_logit,
        )
        return hard_bits
    raise ValueError(f"Unsupported candidate selection mode: {mode}")


def ber_aware_candidate_score(
    bits: torch.Tensor,
    H: torch.Tensor,
    y: torch.Tensor,
    sigma2: float,
    probs: Optional[torch.Tensor] = None,
    selection_tau: float = 0.0,
    posterior_one: Optional[torch.Tensor] = None,
    posterior_alpha: float = 0.0,
    score_mode: str = "policy",
) -> torch.Tensor:
    """Score candidates for final selection. Lower is better.

    Supported modes:
      residual: score = residual energy
      policy: score = residual energy - tau * policy log-prob per bit
      listmap_hybrid: score = residual energy + alpha * CE(bits, list-MAP posterior)
      listmap_ce: score = CE(bits, list-MAP posterior)

    The CE term is normalized per bit.
    """
    if score_mode == "residual":
        return residual_energy(bits, H, y, sigma2)
    if score_mode == "policy":
        score = residual_energy(bits, H, y, sigma2)
        if probs is not None and abs(float(selection_tau)) > 0.0:
            score = score - float(selection_tau) * candidate_logprob_per_bit(bits, probs)
        return score
    if score_mode in {"listmap_ce", "listmap_hybrid"}:
        if posterior_one is None:
            raise ValueError(f"score_mode={score_mode} requires list-MAP posterior_one")
        ce = posterior_disagreement_penalty(bits, posterior_one) / (bits.shape[-2] * bits.shape[-1])
        if score_mode == "listmap_ce":
            return ce
        score = residual_energy(bits, H, y, sigma2)
        score = score + float(posterior_alpha) * ce
        return score
    raise ValueError(f"Unsupported candidate score mode: {score_mode}")


def best_candidate_by_score(
    bits: torch.Tensor,
    H: torch.Tensor,
    y: torch.Tensor,
    sigma2: float,
    probs: Optional[torch.Tensor] = None,
    selection_tau: float = 0.0,
    posterior_one: Optional[torch.Tensor] = None,
    posterior_alpha: float = 0.0,
    score_mode: str = "policy",
) -> Tuple[torch.Tensor, torch.Tensor]:
    score = ber_aware_candidate_score(bits, H, y, sigma2, probs, selection_tau, posterior_one, posterior_alpha, score_mode)
    B = bits.shape[0]
    best_idx = score.argmin(dim=1)
    best_bits = bits[torch.arange(B, device=bits.device), best_idx]
    return best_bits, score[torch.arange(B, device=bits.device), best_idx]


def layerwise_supervised_losses(
    prob_bits_per_layer: List[torch.Tensor],
    true_bits: torch.Tensor,
    posterior_one: Optional[torch.Tensor],
) -> Tuple[torch.Tensor, torch.Tensor]:
    """Return bit-CE to true bits and optional soft-CE to an external posterior."""
    probs_stack = torch.stack(prob_bits_per_layer, dim=0)  # (T, B, K, Nt, BITS_PER_SYMBOL)
    target_true = true_bits[None, :, None, :, :].expand_as(probs_stack)
    bce_true = soft_binary_cross_entropy(probs_stack, target_true)
    if posterior_one is None:
        teacher_ce = probs_stack.new_tensor(0.0)
    else:
        target_teacher = posterior_one[None, :, None, :, :].expand_as(probs_stack)
        teacher_ce = soft_binary_cross_entropy(probs_stack, target_teacher)
    return bce_true, teacher_ce


def listwise_probability_ranking_loss(
    final_bits: torch.Tensor,
    final_probs: torch.Tensor,
    true_bits: torch.Tensor,
    margin: float = 0.05,
) -> torch.Tensor:
    """Differentiable candidate ranking surrogate.

    It picks, inside each channel instance, the simulator candidate with the
    smallest true Hamming distance as positive and the largest-Hamming candidate
    as negative. The model is trained to assign the positive candidate a larger
    average log-probability. This is a direct BER-aware listwise correction and
    is used only during supervised training.
    """
    B, K, _, _ = final_bits.shape
    hamming = (final_bits.round() != true_bits[:, None, :, :].round()).float().mean(dim=(-1, -2))
    pos_idx = hamming.argmin(dim=1)
    neg_idx = hamming.argmax(dim=1)
    row = torch.arange(B, device=final_bits.device)
    pos_bits = final_bits[row, pos_idx]
    neg_bits = final_bits[row, neg_idx]
    pos_probs = final_probs[row, pos_idx]
    neg_probs = final_probs[row, neg_idx]
    pos_logp = candidate_logprob_per_bit(pos_bits[:, None, :, :], pos_probs[:, None, :, :]).squeeze(1)
    neg_logp = candidate_logprob_per_bit(neg_bits[:, None, :, :], neg_probs[:, None, :, :]).squeeze(1)
    return F.relu(float(margin) - (pos_logp - neg_logp)).mean()


def energy_ber_correlation(bits: torch.Tensor, H: torch.Tensor, y: torch.Tensor, sigma2: float, true_bits: torch.Tensor) -> float:
    """Pearson correlation between residual energy and candidate bit-error rate.

    Low or negative values indicate severe residual/BER metric misalignment.
    """
    with torch.no_grad():
        energy = residual_energy(bits, H, y, sigma2).reshape(-1).float()
        biterr = (bits.round() != true_bits[:, None, :, :].round()).float().mean(dim=(-1, -2)).reshape(-1)
        e = energy - energy.mean()
        b = biterr - biterr.mean()
        denom = e.norm() * b.norm() + 1e-12
        return float((e * b).sum().div(denom).clamp(-1, 1).item())


@torch.no_grad()
def best_ber_residual_rank_stats(
    bits: torch.Tensor,
    H: torch.Tensor,
    y: torch.Tensor,
    sigma2: float,
    true_bits: torch.Tensor,
) -> Dict[str, float]:
    """Rank the oracle best-BER candidate inside residual-energy ordering.

    Rank is 1-based, so rank=1 means the lowest-residual candidate is also the
    best-BER candidate for that instance.
    """
    energy = residual_energy(bits, H, y, sigma2)  # (B, K)
    biterr = (bits.round() != true_bits[:, None, :, :].round()).float().mean(dim=(-1, -2))  # (B, K)
    best_ber_idx = biterr.argmin(dim=1)
    residual_order = energy.argsort(dim=1, descending=False)
    ranks = (residual_order == best_ber_idx[:, None]).float().argmax(dim=1).float() + 1.0
    return {
        "mean_rank": ranks.mean().item(),
        "median_rank": ranks.median().item(),
        "top1_rate": (ranks <= 1.0).float().mean().item(),
        "top5_rate": (ranks <= 5.0).float().mean().item(),
    }


@torch.no_grad()
def evaluate_fixed_test_set(
    model: DynamicGraphContextL2ATransformer,
    H: torch.Tensor,
    y: torch.Tensor,
    true_bits: torch.Tensor,
    init_bits: torch.Tensor,
    sigma2: float,
    flip_floor: float,
    local_search_sweeps: int,
    local_search_multi_rounds: int,
    local_search_topk: int,
    local_search_max_pam_hop: int,
    metric_residual_weight: float,
    metric_ber_weight: float,
    selection_posterior_width: int,
    candidate_selection_mode: str,
    residual_consensus_m: int,
) -> Dict[str, float]:
    model.eval()
    B = H.shape[0]
    del metric_residual_weight, metric_ber_weight, selection_posterior_width, candidate_selection_mode
    out = model(
        H,
        y,
        sigma2,
        init_bits,
        sample=True,
        flip_floor=flip_floor,
        local_search_sweeps=local_search_sweeps,
        local_search_multi_rounds=local_search_multi_rounds,
        local_search_topk=local_search_topk,
        local_search_max_pam_hop=local_search_max_pam_hop,
        local_search_posterior_one=None,
        metric_residual_weight=1.0,
        metric_ber_weight=0.0,
    )
    cand = out["final_bits"]
    cand_probs = out["prob_bits_per_layer"][-1]
    residual_best_bits = select_final_bits(
        model,
        cand,
        cand_probs,
        H,
        y,
        true_bits,
        sigma2,
        "Best",
        residual_consensus_m=residual_consensus_m,
    )
    oracle_ber_score = (
        cand.round().long() != true_bits[:, None, :, :].round().long()
    ).float().mean(dim=(-1, -2))
    oracle_ber_idx = oracle_ber_score.argmin(dim=1)
    oracle_ber_bits = cand[torch.arange(B, device=cand.device), oracle_ber_idx]

    total_bits = true_bits.numel()
    residual_best_ber = (
        residual_best_bits.round().long() != true_bits.round().long()
    ).sum().item() / total_bits
    oracle_best_ber = (
        oracle_ber_bits.round().long() != true_bits.round().long()
    ).sum().item() / total_bits
    total_energy = residual_energy(residual_best_bits, H, y, sigma2).sum().item()
    return {
        "ber": 0.5 * (residual_best_ber + oracle_best_ber),
        "residual_energy": total_energy / B,
    }


@torch.no_grad()
def evaluate_fixed_linear_baselines(H: torch.Tensor, y: torch.Tensor, true_bits: torch.Tensor, sigma2: float) -> Dict[str, float]:
    zf_bits = linear_detector_bits(H, y, sigma2, kind="zf")
    lmmse_bits = linear_detector_bits(H, y, sigma2, kind="lmmse")
    total_bits = true_bits.numel()
    return {
        "zf_ber": (zf_bits.round().long() != true_bits.round().long()).sum().item() / total_bits,
        "lmmse_ber": (lmmse_bits.round().long() != true_bits.round().long()).sum().item() / total_bits,
        "zf_residual_energy": residual_energy(zf_bits, H, y, sigma2).mean().item(),
        "lmmse_residual_energy": residual_energy(lmmse_bits, H, y, sigma2).mean().item(),
    }


def train(args: argparse.Namespace) -> None:
    device = torch.device(args.device if torch.cuda.is_available() or args.device == "cpu" else "cpu")
    set_seed(args.seed)
    os.makedirs(args.out_dir, exist_ok=True)

    cfg = MIMOConfig(Nt=8, Nr=8, snr_db=args.snr_db)
    fixed_test_H, fixed_test_y, fixed_test_bits, _ = generate_batch(args.fixed_test_size, cfg, device)
    fixed_test_init_bits = initialize_simulators(
        fixed_test_H,
        fixed_test_y,
        cfg.sigma2,
        K=args.K_test,
        p_symbol=args.perturb_p,
        strong_p_symbol=args.strong_perturb_p,
        mode=args.simulator_init_mode,
    )

    model = DynamicGraphContextL2ATransformer(
        Nt=cfg.Nt,
        d_model=args.d_model,
        num_heads=args.heads,
        d_ff=args.d_ff,
        T=args.layers,
        init_flip_prob=args.init_flip_prob,
    ).to(device)
    total_params = sum(p.numel() for p in model.parameters())
    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
    print(f"Model parameters: total={total_params:,} trainable={trainable_params:,}")
    optimizer = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)

    metrics_path = os.path.join(args.out_dir, "training_metrics.csv")
    ckpt_path = os.path.join(args.out_dir, "mimo_l2a_transformer.pt")
    resume_path = args.resume_path or ckpt_path
    start_step = 1
    ml_benchmark: Dict[str, float] | None = None
    fixed_linear_baselines: Dict[str, float] | None = None
    if args.resume:
        if not os.path.exists(resume_path):
            raise FileNotFoundError(f"Cannot resume because checkpoint does not exist: {resume_path}")
        checkpoint = torch.load(resume_path, map_location=device, weights_only=True)
        model.load_state_dict(checkpoint["model_state"])
        if "optimizer_state" in checkpoint:
            optimizer.load_state_dict(checkpoint["optimizer_state"])
        if "fixed_test" in checkpoint:
            fixed_test = checkpoint["fixed_test"]
            fixed_test_H = fixed_test["H"]
            fixed_test_y = fixed_test["y"]
            fixed_test_bits = fixed_test["true_bits"]
            fixed_test_init_bits = fixed_test["init_bits"]
        if "ml_benchmark" in checkpoint:
            ml_benchmark = checkpoint["ml_benchmark"]
        if "fixed_linear_baselines" in checkpoint:
            fixed_linear_baselines = checkpoint["fixed_linear_baselines"]
        start_step = int(checkpoint.get("step", 0)) + 1
        print(f"Resumed checkpoint: {resume_path} at step={start_step - 1}")

    if fixed_linear_baselines is None:
        fixed_linear_baselines = evaluate_fixed_linear_baselines(fixed_test_H, fixed_test_y, fixed_test_bits, cfg.sigma2)
    print(
        f"Fixed-test linear baselines: ZF_BER={fixed_linear_baselines['zf_ber']:.4e} "
        f"LMMSE_BER={fixed_linear_baselines['lmmse_ber']:.4e} "
        f"ZF_E={fixed_linear_baselines['zf_residual_energy']:.4f} "
        f"LMMSE_E={fixed_linear_baselines['lmmse_residual_energy']:.4f} (n={fixed_test_H.shape[0]})"
    )

    requested_ml_test_size = 0 if args.ml_mode == "off" else max(0, int(args.ml_test_size))
    ml_test_size = min(requested_ml_test_size, int(fixed_test_H.shape[0]))
    effective_ml_mode = args.ml_mode
    if effective_ml_mode == "auto":
        effective_ml_mode = "listmap"
    if ml_test_size == 0:
        ml_benchmark = {
            "ber": float("nan"),
            "residual_energy": float("nan"),
            "num_instances": 0.0,
            "mode": "off",
        }
        print("ML reference benchmark disabled (ml_test_size=0 or ml_mode=off).")
    elif (
        ml_benchmark is None
        or int(ml_benchmark.get("num_instances", -1)) != ml_test_size
        or str(ml_benchmark.get("mode", "")) != effective_ml_mode
    ):
        ml_eval = evaluate_ml_reference(
            fixed_test_H[:ml_test_size],
            fixed_test_y[:ml_test_size],
            fixed_test_bits[:ml_test_size],
            cfg.sigma2,
            mode=effective_ml_mode,
            beam_width=args.ml_kbest_width,
        )
        ml_benchmark = {
            "ber": ml_eval["ber"],
            "residual_energy": ml_eval["residual_energy"],
            "num_instances": float(ml_test_size),
            "mode": ml_eval["mode"],
        }
        print(
            f"ML reference benchmark mode={ml_benchmark['mode']} "
            f"({ml_test_size} fixed test samples): BER={ml_benchmark['ber']:.4e} "
            f"E={ml_benchmark['residual_energy']:.4f}"
        )

    metrics_fieldnames = [
        "step",
        "lambda_entropy",
        "flip_floor",
        "metric_residual_weight",
        "metric_ber_weight",
        "train_loss",
        "train_pg_loss",
        "train_bce_loss",
        "train_teacher_ce_loss",
        "train_rank_loss",
        "train_energy_ber_corr",
        "train_best_ber_residual_mean_rank",
        "train_energy",
        "train_raw_energy",
        "train_refined_energy",
        "train_ls_improvement",
        "fixed_test_ber",
        "zf_ber",
        "lmmse_ber",
        "ml_ber",
        "zf_residual_energy",
        "lmmse_residual_energy",
        "ml_residual_energy",
    ]
    write_metrics_header = not (args.resume and os.path.exists(metrics_path))
    with open(metrics_path, "a" if args.resume else "w", newline="") as f:
        writer = csv.DictWriter(
            f,
            fieldnames=metrics_fieldnames,
        )
        if write_metrics_header:
            writer.writeheader()

    history: List[Dict[str, float]] = []
    printed_baselines = False

    for step in range(start_step, args.steps + 1):
        model.train()
        H, y, true_bits, _ = generate_batch(args.batch_size, cfg, device)
        init_bits = initialize_simulators(
            H,
            y,
            cfg.sigma2,
            K=args.K_train,
            p_symbol=args.perturb_p,
            strong_p_symbol=args.strong_perturb_p,
            mode=args.simulator_init_mode,
        )
        flip_floor = anneal_value(step - 1, args.steps, args.flip_floor_max, args.flip_floor_min)
        metric_residual_weight, metric_ber_weight = metric_curriculum_weights(
            step,
            args.metric_residual_until,
            args.metric_ber_only_from,
            args.metric_residual_floor,
        )
        out = model(
            H,
            y,
            cfg.sigma2,
            init_bits,
            sample=True,
            flip_floor=flip_floor,
            local_search_sweeps=args.local_search_sweeps,
            local_search_multi_rounds=args.local_search_multi_rounds,
            local_search_topk=args.local_search_topk,
            local_search_max_pam_hop=args.local_search_max_pam_hop,
            local_search_posterior_one=None,
            metric_residual_weight=1.0,
            metric_ber_weight=0.0,
        )
        raw_bits_per_layer: List[torch.Tensor] = out["raw_bits_per_layer"]  # list of raw Transformer proposals, (B,K,Nt,8)
        prob_bits_per_layer: List[torch.Tensor] = out["prob_bits_per_layer"]  # Bernoulli probabilities, (B,K,Nt,8)
        bits_per_layer: List[torch.Tensor] = out["bits_per_layer"]  # locally refined candidates, (B,K,Nt,8)
        logprob_per_layer: List[torch.Tensor] = out["logprob_per_layer"]
        entropy_per_layer: List[torch.Tensor] = out["entropy_per_layer"]
        logprob: torch.Tensor = out["logprob"]
        entropy: torch.Tensor = out["entropy"]

        lam = entropy_lambda(step - 1, args.steps, args.lambda_max, args.lambda_min)

        # A single curriculum metric controls PG advantages and the supervised
        # probability objective. Both terms are proportionally normalized inside
        # each batch so residual energy cannot numerically swamp bit BCE.
        layer_energies = torch.stack([residual_energy(bits_t, H, y, cfg.sigma2) for bits_t in bits_per_layer], dim=0)
        layer_true_bce = torch.stack([per_candidate_true_bce(prob_t, true_bits) for prob_t in prob_bits_per_layer], dim=0)
        layer_scores = (
            metric_residual_weight * normalize_positive_metric(layer_energies)
            + metric_ber_weight * normalize_positive_metric(layer_true_bce)
        )

        final_energy = layer_energies[-1]
        raw_final_energy = residual_energy(raw_bits_per_layer[-1], H, y, cfg.sigma2)

        # Policy-gradient objective. Stepwise RTG gives each layer its own future
        # cost signal and improves credit assignment across the trajectory.
        if args.advantage_mode == "stepwise_rtg":
            logprob_stack = torch.stack(logprob_per_layer, dim=0)  # (T,B,K)
            returns = torch.stack([layer_scores[t:].mean(dim=0) for t in range(layer_scores.shape[0])], dim=0)
            advantage = returns - returns.mean(dim=2, keepdim=True)
            advantage = advantage / (returns.std(dim=2, keepdim=True, unbiased=False) + 1e-6)
            advantage = advantage.clamp(-args.advantage_clip, args.advantage_clip)
            pg_loss = (advantage.detach() * logprob_stack).mean()
            entropy_term = torch.stack(entropy_per_layer, dim=0).mean()
        else:
            if args.advantage_mode == "final":
                energy_return = layer_scores[-1]
            elif args.advantage_mode == "trajectory_mean":
                energy_return = layer_scores.mean(dim=0)
            else:
                raise ValueError(f"Unsupported advantage_mode: {args.advantage_mode}")
            advantage = energy_return - energy_return.mean(dim=1, keepdim=True)
            advantage = advantage / (energy_return.std(dim=1, keepdim=True, unbiased=False) + 1e-6)
            advantage = advantage.clamp(-args.advantage_clip, args.advantage_clip)
            pg_loss = (advantage.detach() * logprob).mean()
            entropy_term = entropy.mean()

        # Ground-truth BCE is now the BER-aware supervised component. It is used
        # for optimization after the curriculum turns on metric_ber_weight; no
        # list-MAP teacher is generated in the training loop.
        bce_loss = layer_true_bce.mean()
        teacher_ce_loss = bce_loss.new_tensor(0.0)
        rank_loss = listwise_probability_ranking_loss(
            bits_per_layer[-1].detach(), prob_bits_per_layer[-1], true_bits, margin=args.rank_margin
        )
        merge_bce_loss = bce_loss.new_tensor(0.0)
        if args.candidate_selection_mode.lower() == "merge":
            _merge_bits, merge_posterior, _merge_weights = aggregate_k_candidate_posteriors(
                bits_per_layer[-1].detach(),
                prob_bits_per_layer[-1],
                H,
                y,
                cfg.sigma2,
                confidence_coef=model.merge_confidence_logit,
                residual_coef=model.merge_residual_logit,
            )
            merge_bce_loss = soft_binary_cross_entropy(merge_posterior, true_bits)
        entropy_loss = -lam * entropy_term
        balanced_pg_loss = pg_loss / pg_loss.detach().abs().clamp_min(1e-6)
        balanced_bce_loss = bce_loss / bce_loss.detach().abs().clamp_min(1e-6)
        balanced_merge_loss = merge_bce_loss / merge_bce_loss.detach().abs().clamp_min(1e-6)
        loss = (
            metric_residual_weight * balanced_pg_loss
            + metric_ber_weight * (balanced_bce_loss + balanced_merge_loss)
            + entropy_loss
        )
        train_energy_ber_corr = energy_ber_correlation(bits_per_layer[-1].detach(), H, y, cfg.sigma2, true_bits)
        rank_probe = best_ber_residual_rank_stats(bits_per_layer[-1].detach(), H, y, cfg.sigma2, true_bits)

        optimizer.zero_grad(set_to_none=True)
        loss.backward()
        nn.utils.clip_grad_norm_(model.parameters(), args.grad_clip)
        optimizer.step()

        if step % args.log_every == 0 or step == 1:
            fixed_test = evaluate_fixed_test_set(
                model,
                fixed_test_H,
                fixed_test_y,
                fixed_test_bits,
                fixed_test_init_bits,
                cfg.sigma2,
                flip_floor=flip_floor,
                local_search_sweeps=args.local_search_sweeps,
                local_search_multi_rounds=args.local_search_multi_rounds,
                local_search_topk=args.local_search_topk,
                local_search_max_pam_hop=args.local_search_max_pam_hop,
                metric_residual_weight=metric_residual_weight,
                metric_ber_weight=metric_ber_weight,
                selection_posterior_width=args.selection_posterior_width,
                candidate_selection_mode=args.candidate_selection_mode,
                residual_consensus_m=args.residual_consensus_m,
            )
            row = {
                "step": step,
                "lambda_entropy": lam,
                "flip_floor": flip_floor,
                "metric_residual_weight": metric_residual_weight,
                "metric_ber_weight": metric_ber_weight,
                "train_loss": loss.item(),
                "train_pg_loss": pg_loss.item(),
                "train_bce_loss": bce_loss.item(),
                "train_teacher_ce_loss": teacher_ce_loss.item(),
                "train_rank_loss": rank_loss.item(),
                "train_energy_ber_corr": train_energy_ber_corr,
                "train_best_ber_residual_mean_rank": rank_probe["mean_rank"],
                "train_energy": final_energy.mean().item(),
                "train_raw_energy": raw_final_energy.mean().item(),
                "train_refined_energy": final_energy.mean().item(),
                "train_ls_improvement": (raw_final_energy - final_energy).mean().item(),
                "fixed_test_ber": fixed_test["ber"],
                "zf_ber": fixed_linear_baselines["zf_ber"],
                "lmmse_ber": fixed_linear_baselines["lmmse_ber"],
                "ml_ber": ml_benchmark["ber"],
                "zf_residual_energy": fixed_linear_baselines["zf_residual_energy"],
                "lmmse_residual_energy": fixed_linear_baselines["lmmse_residual_energy"],
                "ml_residual_energy": ml_benchmark["residual_energy"],
            }
            history.append(row)
            with open(metrics_path, "a", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=metrics_fieldnames)
                writer.writerow(row)
            print(
                f"step={step:05d} "
                f"train_raw={row['train_raw_energy']:.4f} train_refined={row['train_refined_energy']:.4f} "
                f"ls_gain={row['train_ls_improvement']:.4f} "
                f"metric_mix=(E:{row['metric_residual_weight']:.3f},BER:{row['metric_ber_weight']:.3f}) "
                f"bce={row['train_bce_loss']:.4f} corr(E,BER)={row['train_energy_ber_corr']:.3f} "
                f"bestBER_residual_rank={row['train_best_ber_residual_mean_rank']:.2f} "
                f"fixed_test_BER={row['fixed_test_ber']:.4e}"
            )
            if not printed_baselines:
                baseline_msg = f"baselines: ZF_BER={row['zf_ber']:.4e} LMMSE_BER={row['lmmse_ber']:.4e}"
                if ml_test_size > 0:
                    baseline_msg += f" MLref({ml_benchmark['mode']})_BER={row['ml_ber']:.4e} (fixed subset n={ml_test_size})"
                print(baseline_msg)
                printed_baselines = True
            make_plots(metrics_path, args.out_dir)
            save_curves_pt(metrics_path, args.out_dir)
            save_metric_pt_files(metrics_path, args.out_dir)

        if step % args.save_every == 0:
            torch.save(
                {
                    "model_state": model.state_dict(),
                    "optimizer_state": optimizer.state_dict(),
                    "args": vars(args),
                    "step": step,
                    "ml_benchmark": ml_benchmark,
                    "fixed_linear_baselines": fixed_linear_baselines,
                    "fixed_test": {
                        "H": fixed_test_H,
                        "y": fixed_test_y,
                        "true_bits": fixed_test_bits,
                        "init_bits": fixed_test_init_bits,
                    },
                },
                ckpt_path,
            )
            print(f"checkpoint saved: {ckpt_path} at step={step}")

    # Save checkpoint and plots.
    torch.save(
        {
            "model_state": model.state_dict(),
            "optimizer_state": optimizer.state_dict(),
            "args": vars(args),
            "step": args.steps,
            "ml_benchmark": ml_benchmark,
            "fixed_linear_baselines": fixed_linear_baselines,
            "fixed_test": {
                "H": fixed_test_H,
                "y": fixed_test_y,
                "true_bits": fixed_test_bits,
                "init_bits": fixed_test_init_bits,
            },
        },
        ckpt_path,
    )
    make_plots(metrics_path, args.out_dir)
    save_curves_pt(metrics_path, args.out_dir)
    save_metric_pt_files(metrics_path, args.out_dir)


def save_curves_pt(metrics_path: str, out_dir: str, filename: str = "curve_data.pt") -> None:
    rows = []
    with open(metrics_path, "r", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            rows.append({k: float(v) for k, v in row.items()})
    if not rows:
        return

    fieldnames = list(rows[0].keys())
    curves = {
        key: torch.tensor([row[key] for row in rows], dtype=torch.float32)
        for key in fieldnames
    }
    payload = {
        "format": "mimo_l2a_curve_data",
        "version": 1,
        "source_csv": os.path.abspath(metrics_path),
        "fieldnames": fieldnames,
        "steps": curves.get("step", torch.arange(len(rows), dtype=torch.float32)),
        "curves": curves,
    }
    torch.save(payload, os.path.join(out_dir, filename))


def save_metric_pt_files(metrics_path: str, out_dir: str) -> None:
    rows = []
    with open(metrics_path, "r", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            rows.append({k: float(v) for k, v in row.items()})
    if not rows:
        return

    steps = torch.tensor([row["step"] for row in rows], dtype=torch.float32)
    curve_specs = [
        ("train_refined_energy", "train_refined_energy.pt"),
        ("fixed_test_ber", "fixed_test_ber.pt"),
    ]
    for metric_name, filename in curve_specs:
        if metric_name not in rows[0]:
            continue
        payload = {
            "format": "mimo_l2a_single_curve",
            "version": 1,
            "source_csv": os.path.abspath(metrics_path),
            "metric_name": metric_name,
            "steps": steps,
            "values": torch.tensor([row[metric_name] for row in rows], dtype=torch.float32),
        }
        torch.save(payload, os.path.join(out_dir, filename))

    last = rows[-1]
    benchmark_names = ["ZF", "LMMSE", "ML(list-MAP)"]
    benchmark_payload = {
        "format": "mimo_l2a_benchmark_summary",
        "version": 1,
        "source_csv": os.path.abspath(metrics_path),
        "names": benchmark_names,
        "residual_energy": torch.tensor(
            [
                last.get("zf_residual_energy", float("nan")),
                last.get("lmmse_residual_energy", float("nan")),
                last.get("ml_residual_energy", float("nan")),
            ],
            dtype=torch.float32,
        ),
        "ber": torch.tensor(
            [
                last.get("zf_ber", float("nan")),
                last.get("lmmse_ber", float("nan")),
                last.get("ml_ber", float("nan")),
            ],
            dtype=torch.float32,
        ),
    }
    benchmark_payload["matrix"] = torch.stack(
        [benchmark_payload["residual_energy"], benchmark_payload["ber"]],
        dim=0,
    )
    benchmark_payload["matrix_rows"] = ["residual_energy", "ber"]
    torch.save(benchmark_payload, os.path.join(out_dir, "benchmark_summary.pt"))


def make_plots(metrics_path: str, out_dir: str) -> None:
    rows = []
    with open(metrics_path, "r", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            rows.append({k: float(v) for k, v in row.items()})
    if not rows:
        return
    steps = [r["step"] for r in rows]

    def series(name: str) -> List[float] | None:
        if name not in rows[0]:
            return None
        return [r[name] for r in rows]

    plt.figure()
    for key, label in [
        ("fixed_test_ber", "Fixed test"),
        ("zf_ber", "ZF"),
        ("lmmse_ber", "LMMSE"),
        ("ml_ber", "ML reference (fixed subset)"),
    ]:
        values = series(key)
        if values is not None:
            plt.semilogy(steps, values, label=label)
    plt.xlabel("Training step")
    plt.ylabel("BER")
    plt.title("BER convergence")
    plt.grid(True, which="both")
    plt.legend()
    plt.tight_layout()
    plt.savefig(os.path.join(out_dir, "ber_convergence.png"), dpi=200)
    plt.close()

    plt.figure()
    energy_curves = [("train_refined_energy", "Train refined final")]
    if "train_refined_energy" not in rows[0] and "train_energy" in rows[0]:
        energy_curves = [("train_energy", "Train")]
    for key, label in energy_curves:
        values = series(key)
        if values is not None:
            plt.plot(steps, values, label=label)
    for key, label in [
        ("zf_residual_energy", "ZF fixed test"),
        ("lmmse_residual_energy", "LMMSE fixed test"),
        ("ml_residual_energy", "ML reference fixed subset"),
    ]:
        values = series(key)
        if values is not None:
            plt.plot(steps, values, linestyle="--", label=label)
    plt.xlabel("Training step")
    plt.ylabel("Normalized residual energy")
    plt.title("Residual energy convergence")
    plt.grid(True)
    plt.legend()
    plt.tight_layout()
    plt.savefig(os.path.join(out_dir, "residual_energy_convergence.png"), dpi=200)
    plt.close()

    ls_improvement = series("train_ls_improvement")
    if ls_improvement is not None:
        plt.figure()
        plt.plot(steps, ls_improvement, label="Train raw-refined")
        plt.xlabel("Training step")
        plt.ylabel("Normalized residual energy decrease")
        plt.title("Local-search energy improvement")
        plt.grid(True)
        plt.legend()
        plt.tight_layout()
        plt.savefig(os.path.join(out_dir, "local_search_improvement.png"), dpi=200)
        plt.close()

    train_loss = series("train_loss")
    if train_loss is not None:
        plt.figure()
        plt.plot(steps, train_loss, label="Train loss")
        plt.xlabel("Training step")
        plt.ylabel("Loss")
        plt.title("Training loss convergence")
        plt.grid(True)
        plt.legend()
        plt.tight_layout()
        plt.savefig(os.path.join(out_dir, "training_loss_convergence.png"), dpi=200)
        plt.close()

    # BER-misalignment diagnostics.
    if "train_bce_loss" in rows[0] or "train_teacher_ce_loss" in rows[0] or "train_rank_loss" in rows[0]:
        plt.figure()
        for key, label in [
            ("train_bce_loss", "True-bit BCE"),
            ("train_teacher_ce_loss", "External teacher CE"),
            ("train_rank_loss", "Listwise ranking"),
        ]:
            values = series(key)
            if values is not None:
                plt.plot(steps, values, label=label)
        plt.xlabel("Training step")
        plt.ylabel("Loss component")
        plt.title("BER-aware loss components")
        plt.grid(True)
        plt.legend()
        plt.tight_layout()
        plt.savefig(os.path.join(out_dir, "ber_aware_loss_components.png"), dpi=200)
        plt.close()

    corr_values = series("train_energy_ber_corr")
    if corr_values is not None:
        plt.figure()
        plt.plot(steps, corr_values, label="corr(E, candidate BER)")
        plt.xlabel("Training step")
        plt.ylabel("Pearson correlation")
        plt.title("Residual-energy / BER alignment diagnostic")
        plt.ylim(-1.05, 1.05)
        plt.grid(True)
        plt.legend()
        plt.tight_layout()
        plt.savefig(os.path.join(out_dir, "energy_ber_correlation.png"), dpi=200)
        plt.close()


def main() -> None:
    parser = argparse.ArgumentParser(description="Dynamic graph-context L2A Transformer for hard 8x8 256-QAM MIMO detection.")
    parser.add_argument("--device", type=str, default="cuda")
    parser.add_argument("--seed", type=int, default=1)
    parser.add_argument("--out-dir", type=str, default="mimo_l2a_results")
    parser.add_argument("--snr-db", type=float, default=20.0)
    parser.add_argument("--steps", type=int, default=50000)
    parser.add_argument("--batch-size", type=int, default=64)
    parser.add_argument("--fixed-test-size", type=int, default=64, help="Number of fixed on-the-fly test samples generated once at training start.")
    parser.add_argument("--ml-test-size", type=int, default=32, help="Number of fixed test samples used for ML reference BER.")
    parser.add_argument("--ml-mode", type=str, default="auto", choices=["auto", "listmap", "exact", "kbest", "off"], help="ML reference mode: listmap uses K-best list soft posterior bit-wise MAP; exact/kbest/off are also available.")
    parser.add_argument("--ml-exact-max-nt", type=int, default=8, help="Kept for compatibility; --ml-mode auto now defaults to listmap for BER-oriented reference.")
    parser.add_argument("--ml-kbest-width", type=int, default=256, help="Beam/list width for K-best and list-MAP references.")
    parser.add_argument("--log-every", type=int, default=10, help="Run fixed on-the-fly test evaluation and record curves every N training steps.")
    parser.add_argument("--save-every", type=int, default=5000)
    parser.add_argument("--resume", action="store_true", help="Resume training from a checkpoint and append to the metrics CSV.")
    parser.add_argument("--resume-path", type=str, default="", help="Checkpoint path to resume from. Defaults to <out-dir>/mimo_l2a_transformer.pt.")
    parser.add_argument("--lr", type=float, default=1e-4)
    parser.add_argument("--weight-decay", type=float, default=1e-4)
    parser.add_argument("--grad-clip", type=float, default=1.0)
    parser.add_argument("--layers", type=int, default=8)
    parser.add_argument("--d-model", type=int, default=128)
    parser.add_argument("--heads", type=int, default=4)
    parser.add_argument("--d-ff", type=int, default=256)
    parser.add_argument("--init-flip-prob", type=float, default=0.5, help="Initial Bernoulli probability for direct bit-value proposals; kept under the old flag name for checkpoint/script compatibility.")
    parser.add_argument("--flip-floor-max", type=float, default=0.05, help="Initial lower bound for direct bit-value proposal probabilities.")
    parser.add_argument("--flip-floor-min", type=float, default=0.005, help="Final lower bound for direct bit-value proposal probabilities.")
    parser.add_argument("--K-train", type=int, default=64)
    parser.add_argument("--K-test", type=int, default=64)
    parser.add_argument("--candidate-selection-mode", type=str, default="Best", choices=["Ave", "Best", "Merge"], help="Final fixed-test K-candidate handling: Ave majority vote, Best single residual-min candidate, or Merge learnable confidence/residual weighted aggregation.")
    parser.add_argument("--residual-consensus-m", type=int, default=5, help="Kept for CLI compatibility; Best mode now uses the single lowest-residual candidate.")
    parser.add_argument("--simulator-init-mode", type=str, default="random", choices=["LMMSE", "random"], help="Simulator initialization mode: LMMSE anchors all simulators around the LMMSE hard slice; random uses fully random QAM bits.")
    parser.add_argument("--perturb-p", type=float, default=0.25, help="LMMSE mode perturbation probability for diversified simulators.")
    parser.add_argument("--strong-perturb-p", type=float, default=0.6, help="LMMSE mode stronger perturbation probability used for a subset of simulators.")
    parser.add_argument("--local-search-multi-rounds", type=int, default=3, help="Number of coarse top-k simultaneous PAM-level perturbation rounds after every Transformer layer.")
    parser.add_argument("--local-search-topk", type=int, default=4, help="Number of QAM symbols changed jointly in each coarse local-search round.")
    parser.add_argument("--local-search-max-pam-hop", type=int, default=2, help="Maximum number of adjacent PAM levels considered by each local-search move; all hops from 1 through this value are evaluated.")
    parser.add_argument("--local-search-sweeps", type=int, default=1, help="Number of fine sequential best-PAM-move sweeps applied after every Transformer layer; set 0 to disable.")

    # One shared metric curriculum controls residual PG and ground-truth BCE.
    # Inference uses neural K-candidate bit-posterior aggregation without labels.
    parser.add_argument("--advantage-mode", type=str, default="stepwise_rtg", choices=["stepwise_rtg", "trajectory_mean", "final"], help="Policy-gradient credit assignment mode.")
    parser.add_argument("--advantage-clip", type=float, default=3.0, help="Clip standardized policy-gradient advantages to [-clip, clip].")
    parser.add_argument("--metric-residual-until", type=int, default=1000, help="Use pure residual energy through this training step.")
    parser.add_argument("--metric-ber-only-from", type=int, default=5000, help="Finish the transition toward the BER-aware metric at this training step.")
    parser.add_argument("--metric-residual-floor", type=float, default=0.3, help="Residual-energy weight retained after the metric curriculum transition.")
    parser.add_argument("--hybrid-posterior-width", type=int, default=64, help="Kept for CLI compatibility; current training uses ground-truth BCE instead of list-MAP labels.")
    parser.add_argument("--selection-posterior-width", type=int, default=64, help="Kept for CLI compatibility; current inference uses neural K-candidate bit aggregation.")
    parser.add_argument("--rank-margin", type=float, default=0.05, help="Margin used only by the logged listwise-ranking diagnostic.")

    parser.add_argument("--lambda-max", type=float, default=0.03, help="Initial entropy regularization weight.")
    parser.add_argument("--lambda-min", type=float, default=0.001, help="Final entropy regularization weight.")
    args = parser.parse_args()
    train(args)


if __name__ == "__main__":
    main()
