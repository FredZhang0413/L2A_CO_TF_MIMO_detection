def build_argparser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Phase-1 soft-IDD MIMO detection (8x8 256-QAM, 5G LDPC).")
    # System
    p.add_argument("--device", type=str, default="cuda")
    p.add_argument("--seed", type=int, default=1)
    p.add_argument("--out-dir", type=str, default="soft_idd_results")
    p.add_argument("--Nt", type=int, default=8)
    p.add_argument("--Nr", type=int, default=8)
    p.add_argument("--snr-db", type=float, default=20.0, help="Training SNR.")
    p.add_argument("--coderate", type=float, default=0.5)
    p.add_argument("--bp-iter", type=int, default=20, help="LDPC BP iterations per decode call.")
    p.add_argument("--cn-update", type=str, default="minsum", choices=["minsum", "boxplus-phi", "boxplus"])
    # Model
    p.add_argument("--layers", type=int, default=8)
    p.add_argument("--d-model", type=int, default=128)
    p.add_argument("--heads", type=int, default=4)
    p.add_argument("--d-ff", type=int, default=256)
    p.add_argument("--init-bit-prob", type=float, default=0.5)
    p.add_argument("--warmstart", type=str, default="", help="Path to a hard-decision checkpoint to warm-start from.")
    # Training
    p.add_argument("--steps", type=int, default=20000)
    p.add_argument("--batch-size", type=int, default=64)
    p.add_argument("--lr", type=float, default=1e-4)
    p.add_argument("--weight-decay", type=float, default=1e-4)
    p.add_argument("--grad-clip", type=float, default=1.0)
    p.add_argument("--K-train", type=int, default=16,
                   help="Parallel detector particles during training; averaged/credited as a population, not selected.")
    p.add_argument("--loss-mode", type=str, default="pure_bce", choices=["pure_bce", "residual_hybrid"],
                   help="Phase-1 objective: pure BCE, or residual-to-hybrid residual/BCE curriculum.")
    p.add_argument("--metric-residual-until", type=int, default=2000,
                   help="For residual_hybrid: keep the curriculum pure residual through this step.")
    p.add_argument("--metric-hybrid-from", type=int, default=10000,
                   help="For residual_hybrid: finish the transition to residual/BCE hybrid by this step.")
    p.add_argument("--metric-residual-floor", type=float, default=0.1,
                   help="For residual_hybrid: residual weight retained after the transition.")
    p.add_argument("--advantage-clip", type=float, default=3.0,
                   help="For residual_hybrid: clip standardized score-function advantages.")
    p.add_argument("--i-a-mode", type=str, default="uniform", choices=["uniform", "beta"])
    p.add_argument("--llr-clip", type=float, default=20.0)
    p.add_argument("--init-mode", type=str, default="lmmse", choices=["lmmse", "random"])
    p.add_argument("--log-every", type=int, default=100)
    p.add_argument("--save-every", type=int, default=2000)
    # Eval / IDD
    p.add_argument("--K-test", type=int, default=32,
                   help="Parallel detector particles for soft posterior averaging; no final candidate selection is used.")
    p.add_argument("--num-idd-iter", type=int, default=3)
    p.add_argument("--eval-snr-db", type=str, default="8,12,16,20,24")
    p.add_argument("--eval-batch-size", type=int, default=128)
    p.add_argument("--eval-batches", type=int, default=8)
    # Modes
    p.add_argument("--mode", type=str, default="all", choices=["all", "p0", "train", "eval"],
                   help="p0=sanity check only; train=Phase-1 training; eval=load+evaluate; all=p0+train+eval.")
    p.add_argument("--ckpt", type=str, default="", help="Checkpoint to load for eval mode.")
    return p


def main() -> None:
    args = build_argparser().parse_args()
    os.makedirs(args.out_dir, exist_ok=True)
    device = torch.device(args.device if (torch.cuda.is_available() or args.device == "cpu") else "cpu")
    set_seed(args.seed)

    if args.mode in ("all", "p0"):
        p0_sanity_check(args)
        if args.mode == "p0":
            return

    cfg = MIMOConfig(Nt=args.Nt, Nr=args.Nr, snr_db=args.snr_db)

    if args.mode in ("all", "train"):
        model, _coded_system, _cfg = train_phase1(args)
    else:  # eval
        model = SoftIDDDetector(Nt=cfg.Nt, d_model=args.d_model, num_heads=args.heads,
                                d_ff=args.d_ff, T=args.layers, init_bit_prob=args.init_bit_prob).to(device)
        ckpt_path = args.ckpt or os.path.join(args.out_dir, "soft_idd_phase1.pt")
        state = torch.load(ckpt_path, map_location=device)
        model.load_state_dict(state["model"] if "model" in state else state)
        print(f"Loaded checkpoint {ckpt_path}")

    if args.mode in ("all", "train", "eval"):
        print("\n=== Evaluating BER vs SNR ===")
        results = evaluate_ber_vs_snr(model, cfg, args, device)
        plot_ber_vs_snr(results, args.num_idd_iter, args.out_dir)

        print("\n=== Detector EXIT curve (loop-health diagnostic) ===")
        exit_curve = detector_exit_curve(model, MIMOConfig(Nt=args.Nt, Nr=args.Nr, snr_db=args.snr_db), args, device)
        plot_exit(exit_curve, args.out_dir)
        print("EXIT I_A:", [round(v, 2) for v in exit_curve["i_a"]])
        print("EXIT I_E:", [round(v, 3) for v in exit_curve["i_e"]])
        print(f"\nAll outputs written to {args.out_dir}")


