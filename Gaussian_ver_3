@dataclass
class MIMOConfig:
    Nt: int = 8
    Nr: int = 8
    snr_db: float = 15.0

    @property
    def sigma2(self) -> float:
        return 10.0 ** (-self.snr_db / 10.0)


def generate_batch(batch_size: int, cfg: MIMOConfig, device: torch.device) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
    """Return H, y, true_bits, true_x."""
    H = complex_normal((batch_size, cfg.Nr, cfg.Nt), device=device, scale=1.0 / math.sqrt(cfg.Nt))
    true_bits = torch.randint(0, 2, (batch_size, cfg.Nt, 4), device=device).float()
    x = bits_to_qam(true_bits)
    noise = complex_normal((batch_size, cfg.Nr), device=device, scale=math.sqrt(cfg.sigma2))
    y = torch.matmul(H, x[..., None]).squeeze(-1) + noise
    return H, y, true_bits, x


def linear_detector_bits(H: torch.Tensor, y: torch.Tensor, sigma2: float, kind: str = "lmmse") -> torch.Tensor:
    """ZF or LMMSE hard-sliced bit estimates."""
    B, Nr, Nt = H.shape
    Hh = H.conj().transpose(-1, -2)
    R = torch.matmul(Hh, H)
    z = torch.matmul(Hh, y[..., None]).squeeze(-1)
    eye = torch.eye(Nt, device=H.device, dtype=H.dtype)[None, :, :]
    if kind.lower() == "lmmse":
        A = R + sigma2 * eye
    elif kind.lower() == "zf":
        A = R + 1e-8 * eye
    else:
        raise ValueError("kind must be 'zf' or 'lmmse'")
    x_hat = torch.linalg.solve(A, z[..., None]).squeeze(-1)
    return qam_to_bits(x_hat)


def neighbor_perturb_bits(bits: torch.Tensor, p_symbol: float = 0.25) -> torch.Tensor:
    """Perturb each selected 16-QAM symbol to a valid neighboring constellation point.

    The perturbation changes either the real-axis or imaginary-axis 4-PAM level by one step.
    This preserves constellation validity and searches adjacent valid points.

    bits shape: (B, Nt, 4)
    """
    device = bits.device
    out = bits.clone()
    B, Nt, _ = bits.shape
    perturb_mask = torch.rand(B, Nt, device=device) < p_symbol

    # Convert current bits to level indices 0..3 for real and imag axes.
    real_level = bits_to_level(out[..., 0:2])
    imag_level = bits_to_level(out[..., 2:4])
    levels_device = LEVELS.to(device)
    real_idx = ((real_level[..., None] - levels_device) ** 2).argmin(dim=-1)
    imag_idx = ((imag_level[..., None] - levels_device) ** 2).argmin(dim=-1)

    choose_real = torch.rand(B, Nt, device=device) < 0.5
    step = torch.where(torch.rand(B, Nt, device=device) < 0.5, -torch.ones(B, Nt, device=device, dtype=torch.long), torch.ones(B, Nt, device=device, dtype=torch.long))

    def valid_move(idx, st):
        # If a boundary move would leave the constellation, reverse it.
        st = torch.where((idx == 0) & (st < 0), torch.ones_like(st), st)
        st = torch.where((idx == 3) & (st > 0), -torch.ones_like(st), st)
        return (idx + st).clamp(0, 3)

    new_real_idx = valid_move(real_idx, step)
    new_imag_idx = valid_move(imag_idx, step)

    new_real_levels = levels_device[new_real_idx]
    new_imag_levels = levels_device[new_imag_idx]
    new_real_bits = level_to_bits(new_real_levels)
    new_imag_bits = level_to_bits(new_imag_levels)

    use_real = perturb_mask & choose_real
    use_imag = perturb_mask & (~choose_real)
    out[..., 0:2] = torch.where(use_real[..., None], new_real_bits, out[..., 0:2])
    out[..., 2:4] = torch.where(use_imag[..., None], new_imag_bits, out[..., 2:4])
    return out


def initialize_simulators(
    H: torch.Tensor,
    y: torch.Tensor,
    sigma2: float,
    K: int,
    p_symbol: float,
    strong_p_symbol: float = 0.6,
) -> torch.Tensor:
    """Create K stable but diverse initial simulator states.

    The first two states are LMMSE and ZF anchors when K allows. Later states
    alternate valid-neighbor perturbations around LMMSE and ZF, using mild and
    stronger perturbation probabilities for diversity without fully random starts.
    """
    lmmse_bits = linear_detector_bits(H, y, sigma2, kind="lmmse")  # (B, Nt, 4)
    zf_bits = linear_detector_bits(H, y, sigma2, kind="zf")
    states = [lmmse_bits]
    if K > 1:
        states.append(zf_bits)

    init_recipes = [
        lambda: neighbor_perturb_bits(lmmse_bits, p_symbol=p_symbol),
        lambda: neighbor_perturb_bits(zf_bits, p_symbol=p_symbol),
        lambda: neighbor_perturb_bits(lmmse_bits, p_symbol=strong_p_symbol),
        lambda: neighbor_perturb_bits(zf_bits, p_symbol=strong_p_symbol),
    ]
    while len(states) < K:
        states.append(init_recipes[(len(states) - 2) % len(init_recipes)]())
    return torch.stack(states, dim=1)  # (B, K, Nt, 4)


@torch.no_grad()
def local_search_refine_bits(
    bits: torch.Tensor,
    H: torch.Tensor,
    y: torch.Tensor,
    sigma2: float,
    sweeps: int = 1,
) -> torch.Tensor:
    """Step-wise random Gray-neighbor greedy refinement.

    bits shape: (B, K, Nt, 4). Each sweep visits every transmit stream in fixed
    order. For each stream and simulator, it samples one valid one-step
    Gray-neighbor move on either the I or Q 4-PAM axis, then accepts only moves
    that decrease the normalized residual energy.
    """
    if sweeps <= 0:
        return bits

    B, K, Nt, _ = bits.shape
    Nr = H.shape[1]
    device = bits.device
    levels = LEVELS.to(device)

    x = bits_to_qam(bits.float())  # (B, K, Nt)
    H_expand = H[:, None, :, :]  # (B, 1, Nr, Nt)
    residual = y[:, None, :] - torch.matmul(H_expand, x[..., None]).squeeze(-1)  # (B, K, Nr)

    real_level = bits_to_level(bits[..., 0:2])
    imag_level = bits_to_level(bits[..., 2:4])
    real_idx = ((real_level[..., None] - levels) ** 2).argmin(dim=-1)
    imag_idx = ((imag_level[..., None] - levels) ** 2).argmin(dim=-1)
    h_norm_sq = (H.abs() ** 2).sum(dim=1).real  # (B, Nt)

    for _ in range(sweeps):
        for i in range(Nt):
            hi = H[:, :, i]  # (B, Nr)
            old_xi = x[:, :, i]  # (B, K)
            ri = real_idx[:, :, i]
            qi = imag_idx[:, :, i]

            valid_moves = torch.stack([ri > 0, ri < 3, qi > 0, qi < 3], dim=-1)
            move_scores = torch.rand(B, K, 4, device=device).masked_fill(~valid_moves, -1.0)
            move = move_scores.argmax(dim=-1)

            new_ri = ri + torch.where(move == 0, -torch.ones_like(ri), torch.where(move == 1, torch.ones_like(ri), torch.zeros_like(ri)))
            new_qi = qi + torch.where(move == 2, -torch.ones_like(qi), torch.where(move == 3, torch.ones_like(qi), torch.zeros_like(qi)))
            new_xi = ((levels[new_ri] + 1j * levels[new_qi]) / QAM_NORM).to(H.dtype)
            delta_x = new_xi - old_xi

            hi_h_residual = (hi.conj()[:, None, :] * residual).sum(dim=-1)  # (B, K)
            delta_energy = ((delta_x.abs() ** 2) * h_norm_sq[:, i, None] - 2.0 * torch.real(delta_x.conj() * hi_h_residual)) / (Nr * sigma2)
            accept = delta_energy < 0.0

            accepted_delta = torch.where(accept, delta_x, torch.zeros_like(delta_x))
            x[:, :, i] = torch.where(accept, new_xi, old_xi)
            residual = residual - hi[:, None, :] * accepted_delta[:, :, None]
            real_idx[:, :, i] = torch.where(accept, new_ri, ri)
            imag_idx[:, :, i] = torch.where(accept, new_qi, qi)

    real_bits = level_to_bits(levels[real_idx])
    imag_bits = level_to_bits(levels[imag_idx])
    return torch.cat([real_bits, imag_bits], dim=-1)


# -----------------------------
# Model components
# -----------------------------


class MLP(nn.Module):
    def __init__(self, in_dim: int, hidden_dim: int, out_dim: int, layers: int = 2):
        super().__init__()
        if layers == 1:
            self.net = nn.Linear(in_dim, out_dim)
        else:
            mods: List[nn.Module] = [nn.Linear(in_dim, hidden_dim), nn.ReLU()]
            for _ in range(layers - 2):
                mods += [nn.Linear(hidden_dim, hidden_dim), nn.ReLU()]
            mods.append(nn.Linear(hidden_dim, out_dim))
            self.net = nn.Sequential(*mods)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.net(x)


class EdgeBiasedTransformerBlock(nn.Module):
    """Self-attention block with complex edge-derived attention bias."""
    def __init__(self, d_model: int, num_heads: int, d_ff: int):
        super().__init__()
        assert d_model % num_heads == 0
        self.d_model = d_model
        self.num_heads = num_heads
        self.head_dim = d_model // num_heads
        self.qkv = nn.Linear(d_model, 3 * d_model)
        self.out = nn.Linear(d_model, d_model)
        self.edge_mlp = MLP(4, d_ff, num_heads, layers=2)
        self.ln1 = nn.LayerNorm(d_model)
        self.ln2 = nn.LayerNorm(d_model)
        self.ffn = nn.Sequential(nn.Linear(d_model, d_ff), nn.ReLU(), nn.Linear(d_ff, d_model))

    def forward(self, h: torch.Tensor, edge_feat: torch.Tensor) -> torch.Tensor:
        """
        h: (BK, Nt, d_model)
        edge_feat: (BK, Nt, Nt, 4)
        """
        x = self.ln1(h)
        BK, Nt, _ = x.shape
        qkv = self.qkv(x).view(BK, Nt, 3, self.num_heads, self.head_dim)
        q, k, v = qkv[:, :, 0], qkv[:, :, 1], qkv[:, :, 2]  # (BK, Nt, H, Dh)
        q = q.transpose(1, 2)  # (BK, H, Nt, Dh)
        k = k.transpose(1, 2)
        v = v.transpose(1, 2)
        logits = torch.matmul(q, k.transpose(-1, -2)) / math.sqrt(self.head_dim)
        edge_bias = self.edge_mlp(edge_feat).permute(0, 3, 1, 2)  # (BK, H, Nt, Nt)
        diag_mask = torch.eye(Nt, device=edge_bias.device, dtype=torch.bool)[None, None, :, :]
        edge_bias = edge_bias.masked_fill(diag_mask, 0.0)
        attn = torch.softmax(logits + edge_bias, dim=-1)
        ctx = torch.matmul(attn, v).transpose(1, 2).contiguous().view(BK, Nt, self.d_model)
        h = h + self.out(ctx)
        h = h + self.ffn(self.ln2(h))
        return h


class DynamicGraphContextL2ATransformer(nn.Module):
    def __init__(
        self,
        Nt: int = 8,
        d_model: int = 128,
        num_heads: int = 4,
        d_ff: int = 256,
        T: int = 8,
        init_flip_prob: float = 0.03,
    ):
        super().__init__()
        self.Nt = Nt
        self.d_model = d_model
        self.T = T
        self.node_mlp = MLP(6, d_ff, d_model, layers=2)
        self.pos_emb = nn.Embedding(Nt, d_model)
        self.sol_mlp = MLP(6, d_ff, d_model, layers=2)
        self.blocks = nn.ModuleList([EdgeBiasedTransformerBlock(d_model, num_heads, d_ff) for _ in range(T)])
        self.ar_token_mlp = MLP(6 + d_model, d_ff, d_model, layers=2)
        self.ar_gru = nn.GRUCell(d_model, d_model)
        self.head_i = MLP(3 * d_model, d_ff, 2, layers=2)
        self.head_q = MLP(3 * d_model, d_ff, 2, layers=2)
        self.init_flip_heads(init_flip_prob)

    def init_flip_heads(self, init_flip_prob: float) -> None:
        """Initialize flip heads so the initial policy mostly keeps the previous solution."""
        init_flip_prob = min(max(init_flip_prob, 1e-5), 1.0 - 1e-5)
        init_bias = math.log(init_flip_prob / (1.0 - init_flip_prob))
        for head in (self.head_i, self.head_q):
            final_layer = head.net[-1] if isinstance(head.net, nn.Sequential) else head.net
            if isinstance(final_layer, nn.Linear):
                nn.init.normal_(final_layer.weight, mean=0.0, std=1e-3)
                nn.init.constant_(final_layer.bias, init_bias)

    def build_context(self, H: torch.Tensor, y: torch.Tensor, sigma2: float, K: int) -> Tuple[torch.Tensor, torch.Tensor]:
        """Build initial node context and edge features.

        Returns:
            Z: (B, K, Nt, d_model)
            edge_feat: (B, K, Nt, Nt, 4)
        """
        B, Nr, Nt = H.shape
        Hh = H.conj().transpose(-1, -2)
        R = torch.matmul(Hh, H)  # (B, Nt, Nt)
        z = torch.matmul(Hh, y[..., None]).squeeze(-1)  # (B, Nt)
        sigma_col = torch.full((B, Nt, 1), float(sigma2), device=H.device)
        idx = torch.arange(Nt, device=H.device).float()[None, :, None].expand(B, Nt, 1) / max(Nt - 1, 1)
        diag_R = R.diagonal(dim1=-2, dim2=-1).real.unsqueeze(-1)
        node_feat = torch.cat([z.real.unsqueeze(-1), z.imag.unsqueeze(-1), z.abs().unsqueeze(-1), diag_R, sigma_col, idx], dim=-1).float()
        pos = self.pos_emb(torch.arange(Nt, device=H.device))[None, :, :]
        Z0 = self.node_mlp(node_feat) + pos
        Z = Z0[:, None, :, :].expand(B, K, Nt, self.d_model).contiguous()

        angle = torch.angle(R)
        edge_feat = torch.stack([R.real, R.imag, R.abs(), angle], dim=-1).float()
        edge_feat = edge_feat[:, None, :, :, :].expand(B, K, Nt, Nt, 4).contiguous()
        return Z, edge_feat

    def solution_embedding(self, bits: torch.Tensor) -> torch.Tensor:
        """bits: (BK, Nt, 4), returns (BK, Nt, d_model)."""
        x = bits_to_qam(bits)
        feat = torch.cat([bits.float(), x.real.unsqueeze(-1), x.imag.unsqueeze(-1)], dim=-1)
        return self.sol_mlp(feat)

    def forward(
        self,
        H: torch.Tensor,
        y: torch.Tensor,
        sigma2: float,
        init_bits: torch.Tensor,
        sample: bool = True,
        flip_floor: float = 0.0,
        local_search_sweeps: int = 1,
    ) -> Dict[str, torch.Tensor | List[torch.Tensor]]:
        """
        Args:
            H: (B, Nr, Nt)
            y: (B, Nr)
            init_bits: (B, K, Nt, 4)
        Returns:
            raw_bits_per_layer: raw Transformer proposals, each (B, K, Nt, 4)
            bits_per_layer: locally refined layer states, each (B, K, Nt, 4)
            final_bits: final locally refined state, (B, K, Nt, 4)
            logprob: (B, K), total raw-proposal trajectory log probability
            entropy: (B, K), total Bernoulli entropy
        """
        B, K, Nt, _ = init_bits.shape
        assert Nt == self.Nt
        Z, edge_feat = self.build_context(H, y, sigma2, K=K)
        bits_prev = init_bits.float()
        logprob = torch.zeros(B, K, device=H.device)
        entropy = torch.zeros(B, K, device=H.device)
        raw_bits_per_layer: List[torch.Tensor] = []
        bits_per_layer: List[torch.Tensor] = []

        BK = B * K
        edge_flat = edge_feat.view(BK, Nt, Nt, 4)

        flip_floor = min(max(float(flip_floor), 0.0), 0.49)

        for t, block in enumerate(self.blocks):
            Z_flat = Z.view(BK, Nt, self.d_model)
            prev_flat = bits_prev.view(BK, Nt, 4)
            h = Z_flat + self.solution_embedding(prev_flat)
            Z_flat = block(h, edge_flat)
            Z = Z_flat.view(B, K, Nt, self.d_model)

            # Across-symbol autoregressive residual-flip generation with
            # I/Q-separated within-symbol mean-field sampling.
            ar_state = torch.zeros(BK, self.d_model, device=H.device)
            new_bits_list: List[torch.Tensor] = []
            prev_sol_emb = self.solution_embedding(prev_flat)

            for i in range(Nt):
                zi = Z_flat[:, i, :]
                prev_i_emb = prev_sol_emb[:, i, :]
                prev_i_bits = prev_flat[:, i, :]
                head_in = torch.cat([zi, ar_state, prev_i_emb], dim=-1)
                flip_probs_i = torch.sigmoid(self.head_i(head_in)).clamp(1e-5, 1.0 - 1e-5)  # (BK, 2)
                flip_probs_q = torch.sigmoid(self.head_q(head_in)).clamp(1e-5, 1.0 - 1e-5)  # (BK, 2)
                if flip_floor > 0.0:
                    flip_probs_i = flip_floor + (1.0 - 2.0 * flip_floor) * flip_probs_i
                    flip_probs_q = flip_floor + (1.0 - 2.0 * flip_floor) * flip_probs_q
                if sample:
                    flip_i = torch.bernoulli(flip_probs_i)
                    flip_q = torch.bernoulli(flip_probs_q)
                else:
                    flip_i = (flip_probs_i >= 0.5).float()
                    flip_q = (flip_probs_q >= 0.5).float()
                flip_mask = torch.cat([flip_i, flip_q], dim=-1)
                bi = torch.remainder(prev_i_bits + flip_mask, 2.0)
                lp_i = flip_i * torch.log(flip_probs_i) + (1.0 - flip_i) * torch.log(1.0 - flip_probs_i)
                lp_q = flip_q * torch.log(flip_probs_q) + (1.0 - flip_q) * torch.log(1.0 - flip_probs_q)
                ent_i = -(flip_probs_i * torch.log(flip_probs_i) + (1.0 - flip_probs_i) * torch.log(1.0 - flip_probs_i))
                ent_q = -(flip_probs_q * torch.log(flip_probs_q) + (1.0 - flip_probs_q) * torch.log(1.0 - flip_probs_q))
                lp = torch.cat([lp_i, lp_q], dim=-1)
                ent = torch.cat([ent_i, ent_q], dim=-1)
                logprob = logprob + lp.sum(dim=-1).view(B, K)
                entropy = entropy + ent.sum(dim=-1).view(B, K)
                new_bits_list.append(bi.view(B, K, 1, 4))

                # Update AR state using the newly generated valid 16-QAM symbol bits.
                bi_bk = bi.view(BK, 1, 4)
                xi = bits_to_qam(bi_bk).view(BK)
                pos_i = Z_flat[:, i, :]
                ar_feat = torch.cat([bi, xi.real.unsqueeze(-1), xi.imag.unsqueeze(-1), pos_i], dim=-1)
                ar_token = self.ar_token_mlp(ar_feat)
                ar_state = self.ar_gru(ar_token, ar_state)

            bits_curr = torch.cat(new_bits_list, dim=2)  # (B, K, Nt, 4)
            refined_bits = local_search_refine_bits(bits_curr, H, y, sigma2, sweeps=local_search_sweeps)
            raw_bits_per_layer.append(bits_curr)
            bits_per_layer.append(refined_bits)
            bits_prev = refined_bits

        return {
            "raw_bits_per_layer": raw_bits_per_layer,
            "bits_per_layer": bits_per_layer,
            "final_bits": bits_prev,
            "logprob": logprob,
            "entropy": entropy,
        }


# -----------------------------
# Training and evaluation
# -----------------------------


def entropy_lambda(step: int, total_steps: int, lam_max: float, lam_min: float) -> float:
    if total_steps <= 1:
        return lam_min
    frac = min(max(step / float(total_steps - 1), 0.0), 1.0)
    return lam_max * ((lam_min / lam_max) ** frac)


def anneal_value(step: int, total_steps: int, value_max: float, value_min: float) -> float:
    if total_steps <= 1:
        return value_min
    frac = min(max(step / float(total_steps - 1), 0.0), 1.0)
    if value_max <= 0.0 or value_min <= 0.0:
        return value_max + frac * (value_min - value_max)
    return value_max * ((value_min / value_max) ** frac)


@torch.no_grad()
def evaluate_model(
    model: DynamicGraphContextL2ATransformer,
    cfg: MIMOConfig,
    batch_size: int,
    batches: int,
    K_test: int,
    perturb_p: float,
    strong_perturb_p: float,
    flip_floor: float,
    local_search_sweeps: int,
    device: torch.device,
) -> Dict[str, float]:
    model.eval()
    total_bits = 0
    total_bit_errors = 0
    total_energy = 0.0
    zf_errors = 0
    lmmse_errors = 0
    for _ in range(batches):
        H, y, true_bits, _ = generate_batch(batch_size, cfg, device)
        init_bits = initialize_simulators(H, y, cfg.sigma2, K=K_test, p_symbol=perturb_p, strong_p_symbol=strong_perturb_p)
        out = model(H, y, cfg.sigma2, init_bits, sample=True, flip_floor=flip_floor, local_search_sweeps=local_search_sweeps)
        cand = out["final_bits"]  # (B, K, Nt, 4)
        energy = residual_energy(cand, H, y, cfg.sigma2)  # (B, K)
        best_idx = energy.argmin(dim=1)
        best_bits = cand[torch.arange(batch_size, device=device), best_idx]
        total_bit_errors += (best_bits.round().long() != true_bits.round().long()).sum().item()
        total_bits += true_bits.numel()
        total_energy += energy[torch.arange(batch_size, device=device), best_idx].sum().item()

        zf_bits = linear_detector_bits(H, y, cfg.sigma2, kind="zf")
        lmmse_bits = linear_detector_bits(H, y, cfg.sigma2, kind="lmmse")
        zf_errors += (zf_bits.round().long() != true_bits.round().long()).sum().item()
        lmmse_errors += (lmmse_bits.round().long() != true_bits.round().long()).sum().item()

    return {
        "ber": total_bit_errors / total_bits,
        "residual_energy": total_energy / (batch_size * batches),
        "zf_ber": zf_errors / total_bits,
        "lmmse_ber": lmmse_errors / total_bits,
    }


@torch.no_grad()
def evaluate_fixed_test_set(
    model: DynamicGraphContextL2ATransformer,
    H: torch.Tensor,
    y: torch.Tensor,
    true_bits: torch.Tensor,
    init_bits: torch.Tensor,
    sigma2: float,
    flip_floor: float,
    local_search_sweeps: int,
) -> Dict[str, float]:
    model.eval()
    B = H.shape[0]
    out = model(H, y, sigma2, init_bits, sample=True, flip_floor=flip_floor, local_search_sweeps=local_search_sweeps)
    cand = out["final_bits"]
    energy = residual_energy(cand, H, y, sigma2)
    best_idx = energy.argmin(dim=1)
    best_bits = cand[torch.arange(B, device=H.device), best_idx]
    bit_errors = (best_bits.round().long() != true_bits.round().long()).sum().item()
    total_energy = energy[torch.arange(B, device=H.device), best_idx].sum().item()
    return {
        "ber": bit_errors / true_bits.numel(),
        "residual_energy": total_energy / B,
    }


def train(args: argparse.Namespace) -> None:
    device = torch.device(args.device if torch.cuda.is_available() or args.device == "cpu" else "cpu")
    set_seed(args.seed)
    os.makedirs(args.out_dir, exist_ok=True)

    cfg = MIMOConfig(Nt=8, Nr=8, snr_db=args.snr_db)
    fixed_test_H, fixed_test_y, fixed_test_bits, _ = generate_batch(args.fixed_test_size, cfg, device)
    fixed_test_init_bits = initialize_simulators(
        fixed_test_H,
        fixed_test_y,
        cfg.sigma2,
        K=args.K_test,
        p_symbol=args.perturb_p,
        strong_p_symbol=args.strong_perturb_p,
    )

    model = DynamicGraphContextL2ATransformer(
        Nt=cfg.Nt,
        d_model=args.d_model,
        num_heads=args.heads,
        d_ff=args.d_ff,
        T=args.layers,
        init_flip_prob=args.init_flip_prob,
    ).to(device)
    total_params = sum(p.numel() for p in model.parameters())
    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
    print(f"Model parameters: total={total_params:,} trainable={trainable_params:,}")
    optimizer = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)

    metrics_path = os.path.join(args.out_dir, "training_metrics.csv")
    ckpt_path = os.path.join(args.out_dir, "mimo_l2a_transformer.pt")
    resume_path = args.resume_path or ckpt_path
    start_step = 1
    if args.resume:
        if not os.path.exists(resume_path):
            raise FileNotFoundError(f"Cannot resume because checkpoint does not exist: {resume_path}")
        checkpoint = torch.load(resume_path, map_location=device, weights_only=True)
        model.load_state_dict(checkpoint["model_state"])
        if "optimizer_state" in checkpoint:
            optimizer.load_state_dict(checkpoint["optimizer_state"])
        if "fixed_test" in checkpoint:
            fixed_test = checkpoint["fixed_test"]
            fixed_test_H = fixed_test["H"]
            fixed_test_y = fixed_test["y"]
            fixed_test_bits = fixed_test["true_bits"]
            fixed_test_init_bits = fixed_test["init_bits"]
        start_step = int(checkpoint.get("step", 0)) + 1
        print(f"Resumed checkpoint: {resume_path} at step={start_step - 1}")

    metrics_fieldnames = [
        "step",
        "lambda_entropy",
        "flip_floor",
        "train_loss",
        "train_energy",
        "train_raw_energy",
        "train_refined_energy",
        "train_ls_improvement",
        "val_ber",
        "val_residual_energy",
        "fixed_test_ber",
        "fixed_test_residual_energy",
        "zf_ber",
        "lmmse_ber",
    ]
    write_metrics_header = not (args.resume and os.path.exists(metrics_path))
    with open(metrics_path, "a" if args.resume else "w", newline="") as f:
        writer = csv.DictWriter(
            f,
            fieldnames=metrics_fieldnames,
        )
        if write_metrics_header:
            writer.writeheader()

    history: List[Dict[str, float]] = []
    printed_baselines = False

    for step in range(start_step, args.steps + 1):
        model.train()
        H, y, true_bits, _ = generate_batch(args.batch_size, cfg, device)
        init_bits = initialize_simulators(H, y, cfg.sigma2, K=args.K_train, p_symbol=args.perturb_p, strong_p_symbol=args.strong_perturb_p)
        flip_floor = anneal_value(step - 1, args.steps, args.flip_floor_max, args.flip_floor_min)
        out = model(H, y, cfg.sigma2, init_bits, sample=True, flip_floor=flip_floor, local_search_sweeps=args.local_search_sweeps)
        raw_bits_per_layer: List[torch.Tensor] = out["raw_bits_per_layer"]  # list of raw Transformer proposals, (B,K,Nt,4)
        bits_per_layer: List[torch.Tensor] = out["bits_per_layer"]  # list of (B,K,Nt,4)
        logprob: torch.Tensor = out["logprob"]
        entropy: torch.Tensor = out["entropy"]

        # Advantage uses the locally refined trajectory energy. The policy score
        # still comes from the raw Transformer samples through logprob.
        layer_energies = torch.stack([residual_energy(bits_t, H, y, cfg.sigma2) for bits_t in bits_per_layer], dim=0)
        energy_return = layer_energies.mean(dim=0)  # uniform omega_t over refined layers, (B, K)
        final_energy = layer_energies[-1]
        raw_final_energy = residual_energy(raw_bits_per_layer[-1], H, y, cfg.sigma2)

        # Within-instance standardized advantage. This reduces both channel-instance
        # difficulty variance and per-instance energy scale variance.
        advantage = energy_return - energy_return.mean(dim=1, keepdim=True)
        advantage = advantage / (energy_return.std(dim=1, keepdim=True, unbiased=False) + 1e-6)
        advantage = advantage.detach()
        lam = entropy_lambda(step - 1, args.steps, args.lambda_max, args.lambda_min)

        # Policy-gradient surrogate for minimizing energy with entropy regularization.
        pg_loss = (advantage * logprob).mean()
        entropy_loss = -lam * entropy.mean()
        loss = pg_loss + entropy_loss

        optimizer.zero_grad(set_to_none=True)
        loss.backward()
        nn.utils.clip_grad_norm_(model.parameters(), args.grad_clip)
        optimizer.step()

        if step % args.log_every == 0 or step == 1:
            val = evaluate_model(
                model,
                cfg,
                batch_size=args.val_batch_size,
                batches=args.val_batches,
                K_test=args.K_test,
                perturb_p=args.perturb_p,
                strong_perturb_p=args.strong_perturb_p,
                flip_floor=flip_floor,
                local_search_sweeps=args.local_search_sweeps,
                device=device,
            )
            fixed_test = evaluate_fixed_test_set(
                model,
                fixed_test_H,
                fixed_test_y,
                fixed_test_bits,
                fixed_test_init_bits,
                cfg.sigma2,
                flip_floor=flip_floor,
                local_search_sweeps=args.local_search_sweeps,
            )
            row = {
                "step": step,
                "lambda_entropy": lam,
                "flip_floor": flip_floor,
                "train_loss": loss.item(),
                "train_energy": final_energy.mean().item(),
                "train_raw_energy": raw_final_energy.mean().item(),
                "train_refined_energy": final_energy.mean().item(),
                "train_ls_improvement": (raw_final_energy - final_energy).mean().item(),
                "val_ber": val["ber"],
                "val_residual_energy": val["residual_energy"],
                "fixed_test_ber": fixed_test["ber"],
                "fixed_test_residual_energy": fixed_test["residual_energy"],
                "zf_ber": val["zf_ber"],
                "lmmse_ber": val["lmmse_ber"],
            }
            history.append(row)
            with open(metrics_path, "a", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=metrics_fieldnames)
                writer.writerow(row)
            print(
                f"step={step:05d} "
                f"train_raw={row['train_raw_energy']:.4f} train_refined={row['train_refined_energy']:.4f} "
                f"ls_gain={row['train_ls_improvement']:.4f} "
                f"val_BER={row['val_ber']:.4e} fixed_test_BER={row['fixed_test_ber']:.4e}"
            )
            if not printed_baselines:
                print(f"baselines: ZF_BER={row['zf_ber']:.4e} LMMSE_BER={row['lmmse_ber']:.4e}")
                printed_baselines = True
            make_plots(metrics_path, args.out_dir)

        if step % args.save_every == 0:
            torch.save(
                {
                    "model_state": model.state_dict(),
                    "optimizer_state": optimizer.state_dict(),
                    "args": vars(args),
                    "step": step,
                    "fixed_test": {
                        "H": fixed_test_H,
                        "y": fixed_test_y,
                        "true_bits": fixed_test_bits,
                        "init_bits": fixed_test_init_bits,
                    },
                },
                ckpt_path,
            )
            print(f"checkpoint saved: {ckpt_path} at step={step}")

    # Save checkpoint and plots.
    torch.save(
        {
            "model_state": model.state_dict(),
            "optimizer_state": optimizer.state_dict(),
            "args": vars(args),
            "step": args.steps,
            "fixed_test": {
                "H": fixed_test_H,
                "y": fixed_test_y,
                "true_bits": fixed_test_bits,
                "init_bits": fixed_test_init_bits,
            },
        },
        ckpt_path,
    )
    make_plots(metrics_path, args.out_dir)


def make_plots(metrics_path: str, out_dir: str) -> None:
    rows = []
    with open(metrics_path, "r", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            rows.append({k: float(v) for k, v in row.items()})
    if not rows:
        return
    steps = [r["step"] for r in rows]

    def series(name: str) -> List[float] | None:
        if name not in rows[0]:
            return None
        return [r[name] for r in rows]

    plt.figure()
    for key, label in [
        ("val_ber", "Validation"),
        ("fixed_test_ber", "Fixed test"),
        ("zf_ber", "ZF"),
        ("lmmse_ber", "LMMSE"),
    ]:
        values = series(key)
        if values is not None:
            plt.semilogy(steps, values, label=label)
    plt.xlabel("Training step")
    plt.ylabel("BER")
    plt.title("BER convergence")
    plt.grid(True, which="both")
    plt.legend()
    plt.tight_layout()
    plt.savefig(os.path.join(out_dir, "ber_convergence.png"), dpi=200)
    plt.close()

    plt.figure()
    energy_curves = [
        ("train_raw_energy", "Train raw final"),
        ("train_refined_energy", "Train refined final"),
    ]
    if "train_refined_energy" not in rows[0]:
        energy_curves.append(("train_energy", "Train"))
    energy_curves += [
        ("val_residual_energy", "Validation refined"),
        ("fixed_test_residual_energy", "Fixed test refined"),
    ]
    for key, label in energy_curves:
        values = series(key)
        if values is not None:
            plt.plot(steps, values, label=label)
    plt.xlabel("Training step")
    plt.ylabel("Normalized residual energy")
    plt.title("Residual energy convergence")
    plt.grid(True)
    plt.legend()
    plt.tight_layout()
    plt.savefig(os.path.join(out_dir, "residual_energy_convergence.png"), dpi=200)
    plt.close()

    ls_improvement = series("train_ls_improvement")
    if ls_improvement is not None:
        plt.figure()
        plt.plot(steps, ls_improvement, label="Train raw-refined")
        plt.xlabel("Training step")
        plt.ylabel("Normalized residual energy decrease")
        plt.title("Local-search energy improvement")
        plt.grid(True)
        plt.legend()
        plt.tight_layout()
        plt.savefig(os.path.join(out_dir, "local_search_improvement.png"), dpi=200)
        plt.close()

    train_loss = series("train_loss")
    if train_loss is not None:
        plt.figure()
        plt.plot(steps, train_loss, label="Train loss")
        plt.xlabel("Training step")
        plt.ylabel("Loss")
        plt.title("Training loss convergence")
        plt.grid(True)
        plt.legend()
        plt.tight_layout()
        plt.savefig(os.path.join(out_dir, "training_loss_convergence.png"), dpi=200)
        plt.close()


def main() -> None:
    parser = argparse.ArgumentParser(description="Dynamic graph-context L2A Transformer for hard 8x8 16-QAM MIMO detection.")
    parser.add_argument("--device", type=str, default="cuda")
    parser.add_argument("--seed", type=int, default=1)
    parser.add_argument("--out-dir", type=str, default="mimo_l2a_results")
    parser.add_argument("--snr-db", type=float, default=15.0)
    parser.add_argument("--steps", type=int, default=100000)
    parser.add_argument("--batch-size", type=int, default=64)
    parser.add_argument("--val-batch-size", type=int, default=512)
    parser.add_argument("--val-batches", type=int, default=4)
    parser.add_argument("--fixed-test-size", type=int, default=128, help="Number of fixed on-the-fly test samples generated once at training start.")
    parser.add_argument("--log-every", type=int, default=200)
    parser.add_argument("--save-every", type=int, default=5000)
    parser.add_argument("--resume", action="store_true", help="Resume training from a checkpoint and append to the metrics CSV.")
    parser.add_argument("--resume-path", type=str, default="", help="Checkpoint path to resume from. Defaults to <out-dir>/mimo_l2a_transformer.pt.")
    parser.add_argument("--lr", type=float, default=1e-4)
    parser.add_argument("--weight-decay", type=float, default=1e-4)
    parser.add_argument("--grad-clip", type=float, default=1.0)
    parser.add_argument("--layers", type=int, default=8)
    parser.add_argument("--d-model", type=int, default=128)
    parser.add_argument("--heads", type=int, default=4)
    parser.add_argument("--d-ff", type=int, default=256)
    parser.add_argument("--init-flip-prob", type=float, default=0.03, help="Initial Bernoulli probability for residual bit flips.")
    parser.add_argument("--flip-floor-max", type=float, default=0.05, help="Initial lower bound for residual flip probabilities.")
    parser.add_argument("--flip-floor-min", type=float, default=0.005, help="Final lower bound for residual flip probabilities.")
    parser.add_argument("--K-train", type=int, default=32)
    parser.add_argument("--K-test", type=int, default=32)
    parser.add_argument("--perturb-p", type=float, default=0.25, help="Symbol-level valid-neighbor perturbation probability for non-LMMSE simulators.")
    parser.add_argument("--strong-perturb-p", type=float, default=0.6, help="Symbol-level perturbation probability for strong mixed initialization.")
    parser.add_argument("--local-search-sweeps", type=int, default=1, help="Number of random Gray-neighbor greedy local-search sweeps applied after every Transformer layer; set 0 to disable.")
    parser.add_argument("--lambda-max", type=float, default=0.03)
    parser.add_argument("--lambda-min", type=float, default=0.001)
    args = parser.parse_args()
    train(args)


if __name__ == "__main__":
    main()
