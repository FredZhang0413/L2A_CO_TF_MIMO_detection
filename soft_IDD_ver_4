def plot_ber_vs_snr(results: Dict[str, object], num_idd_iter: int, out_dir: str) -> None:
    snr = results["snr_db"]
    det = results["det_ber_by_iter"]
    dec = results["dec_ber_by_iter"]

    plt.figure()
    for it in [1, num_idd_iter] if num_idd_iter > 1 else [1]:
        plt.semilogy(snr, [max(v, 1e-6) for v in det[it]], marker="o", label=f"detector coded BER (IDD {it})")
        plt.semilogy(snr, [max(v, 1e-6) for v in dec[it]], marker="s", linestyle="--",
                     label=f"post-LDPC coded BER (IDD {it})")
    plt.semilogy(snr, [max(v, 1e-6) for v in results["lmmse_ber"]], marker="x", color="gray", label="LMMSE")
    plt.xlabel("SNR (dB)"); plt.ylabel("coded BER"); plt.title("Soft-IDD BER vs SNR")
    plt.grid(True, which="both"); plt.legend(); plt.tight_layout()
    plt.savefig(os.path.join(out_dir, "ber_vs_snr.png"), dpi=180); plt.close()

    # IDD convergence at the best (highest) SNR point.
    plt.figure()
    iters = list(range(1, num_idd_iter + 1))
    best = -1
    plt.semilogy(iters, [max(det[it][best], 1e-6) for it in iters], marker="o", label="detector coded BER")
    plt.semilogy(iters, [max(dec[it][best], 1e-6) for it in iters], marker="s", label="post-LDPC coded BER")
    plt.xlabel("IDD iteration"); plt.ylabel("coded BER")
    plt.title(f"IDD convergence @ {snr[best]:.0f} dB")
    plt.grid(True, which="both"); plt.legend(); plt.tight_layout()
    plt.savefig(os.path.join(out_dir, "idd_convergence.png"), dpi=180); plt.close()


def plot_exit(exit_curve: Dict[str, List[float]], out_dir: str) -> None:
    plt.figure()
    plt.plot(exit_curve["i_a"], exit_curve["i_e"], marker="o", label="detector I_E vs I_A")
    plt.plot([0, 1], [0, 1], linestyle=":", color="gray", label="reference y=x")
    plt.xlabel("I_A (a-priori MI)"); plt.ylabel("I_E (extrinsic MI)")
    plt.title("Detector EXIT curve")
    plt.xlim(0, 1); plt.ylim(0, 1)
    plt.grid(True); plt.legend(); plt.tight_layout()
    plt.savefig(os.path.join(out_dir, "exit_chart.png"), dpi=180); plt.close()


