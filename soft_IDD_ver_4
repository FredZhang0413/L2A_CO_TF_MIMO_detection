def read_numeric_metric_rows(metrics_path: str) -> Tuple[List[Dict[str, object]], List[str]]:
    """Read a metrics CSV and keep numeric curves in 5_20_2-style plotting helpers."""
    if not os.path.exists(metrics_path):
        return [], []
    rows: List[Dict[str, object]] = []
    with open(metrics_path, "r", newline="") as f:
        reader = csv.DictReader(f)
        fieldnames = reader.fieldnames or []
        for raw in reader:
            row: Dict[str, object] = {}
            for key, value in raw.items():
                try:
                    row[key] = float(value)
                except (TypeError, ValueError):
                    row[key] = value
            rows.append(row)
    return rows, fieldnames


def numeric_series(rows: List[Dict[str, object]], name: str) -> Optional[List[float]]:
    if not rows or name not in rows[0]:
        return None
    values: List[float] = []
    for row in rows:
        value = row.get(name, float("nan"))
        if isinstance(value, (int, float)):
            values.append(float(value))
        else:
            return None
    return values


def save_curves_pt(metrics_path: str, out_dir: str, filename: str = "curve_data.pt") -> None:
    rows, fieldnames = read_numeric_metric_rows(metrics_path)
    if not rows:
        return
    curves: Dict[str, torch.Tensor] = {}
    numeric_fieldnames: List[str] = []
    for key in fieldnames:
        values = numeric_series(rows, key)
        if values is None:
            continue
        numeric_fieldnames.append(key)
        curves[key] = torch.tensor(values, dtype=torch.float32)
    if not curves:
        return
    payload = {
        "format": "soft_idd_curve_data",
        "version": 1,
        "source_csv": os.path.abspath(metrics_path),
        "fieldnames": numeric_fieldnames,
        "steps": curves.get("step", torch.arange(len(rows), dtype=torch.float32)),
        "curves": curves,
    }
    torch.save(payload, os.path.join(out_dir, filename))


def save_metric_pt_files(metrics_path: str, out_dir: str, args) -> None:
    rows, _fieldnames = read_numeric_metric_rows(metrics_path)
    if not rows:
        return
    steps_values = numeric_series(rows, "step")
    if steps_values is None:
        return
    steps = torch.tensor(steps_values, dtype=torch.float32)

    curve_specs = [
        ("first_pass_coded_ber", "train_first_round_coded_ber.pt"),
        ("train_coded_ber", "train_second_round_coded_ber.pt"),
    ]
    for metric_name, filename in curve_specs:
        values = numeric_series(rows, metric_name)
        if values is None:
            continue
        payload = {
            "format": "soft_idd_single_curve",
            "version": 1,
            "source_csv": os.path.abspath(metrics_path),
            "metric_name": metric_name,
            "steps": steps,
            "values": torch.tensor(values, dtype=torch.float32),
        }
        torch.save(payload, os.path.join(out_dir, filename))

    first = numeric_series(rows, "first_pass_coded_ber")
    second = numeric_series(rows, "train_coded_ber")
    if first is not None and second is not None:
        payload = {
            "format": "soft_idd_train_coded_ber_trace",
            "version": 1,
            "source_csv": os.path.abspath(metrics_path),
            "metadata": {
                "description": "Logged train coded-bit BER before/after decoder-derived prior tilt.",
                "first_round_coded_ber": "Detector posterior coded BER with L_A=0 before the LDPC decoder prior.",
                "second_round_coded_ber": "Detector posterior coded BER after one decoder prior and prior-tilted sampling.",
                "log_every": int(args.log_every),
                "snr_db": float(args.snr_db),
                "K_train": int(args.K_train),
                "init_mode": str(args.init_mode),
                "weight_init": str(args.weight_init),
                "prior_source": str(args.prior_source),
                "loss_mode": str(args.loss_mode),
                "num_train_loops": int(args.num_train_loops),
                "loop_parameterization": "untied",
            },
            "step": steps.to(dtype=torch.long),
            "first_round_coded_ber": torch.tensor(first, dtype=torch.float32),
            "second_round_coded_ber": torch.tensor(second, dtype=torch.float32),
        }
        torch.save(payload, os.path.join(out_dir, args.train_ber_trace_name))


