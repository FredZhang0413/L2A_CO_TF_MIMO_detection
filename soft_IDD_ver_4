def build_argparser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Phase-1 soft-IDD MIMO detection (16x16 256-QAM, 5G LDPC).")
    # System
    p.add_argument("--device", type=str, default="cuda")
    p.add_argument("--seed", type=int, default=1)
    p.add_argument("--out-dir", type=str, default="soft_idd_results")
    p.add_argument("--Nt", type=int, default=16)
    p.add_argument("--Nr", type=int, default=16)
    p.add_argument("--snr-db", type=float, default=30.0, help="Training SNR.")
    p.add_argument("--coherence-periods", type=int, default=20,
                   help="Number of independent CSI periods concatenated into one LDPC codeword.")
    p.add_argument("--coderate", type=float, default=0.5)
    p.add_argument("--bp-iter", type=int, default=20, help="LDPC BP iterations per decode call.")
    p.add_argument("--cn-update", type=str, default="minsum", choices=["minsum", "boxplus-phi", "boxplus"])
    # Model
    p.add_argument("--layers", type=int, default=8)
    p.add_argument("--d-model", type=int, default=256)
    p.add_argument("--heads", type=int, default=8)
    p.add_argument("--d-ff", type=int, default=256)
    p.add_argument("--init-bit-prob", type=float, default=0.5)
    p.add_argument("--weight-init", type=str, default="warmstart", choices=["warmstart", "random"],
                   help="Network weight initialization: load the hard detector checkpoint or train from random weights.")
    p.add_argument(
        "--warmstart",
        type=str,
        # default=os.path.join("mimo_l2a_results", "5_20_4_results", "CL", "mimo_l2a_transformer.pt"),
        default=os.path.join("mimo_l2a_transformer.pt"),
        help="Path to a hard-decision checkpoint to warm-start from.",
    )
    # Training
    p.add_argument("--steps", type=int, default=20000)
    p.add_argument("--batch-size", type=int, default=32)
    p.add_argument("--lr", type=float, default=1e-4)
    p.add_argument("--weight-decay", type=float, default=1e-4)
    p.add_argument("--grad-clip", type=float, default=1.0)
    p.add_argument("--K-train", type=int, default=16,
                   help="Parallel detector particles during training; averaged/credited as a population, not selected.")
    p.add_argument("--loss-mode", type=str, default="pure_bce", choices=["pure_bce", "residual_hybrid"],
                   help="Phase-1 objective: pure BCE, or residual-to-hybrid residual/BCE curriculum.")
    p.add_argument("--metric-residual-until", type=int, default=2000,
                   help="For residual_hybrid: keep the curriculum pure residual through this step.")
    p.add_argument("--metric-hybrid-from", type=int, default=10000,
                   help="For residual_hybrid: finish the transition to residual/BCE hybrid by this step.")
    p.add_argument("--metric-residual-floor", type=float, default=0.1,
                   help="For residual_hybrid: residual weight retained after the transition.")
    p.add_argument("--advantage-clip", type=float, default=3.0,
                   help="For residual_hybrid: clip standardized score-function advantages.")
    p.add_argument("--prior-source", type=str, default="decoder_onepass",
                   choices=["gaussian", "decoder_onepass", "mixed"],
                   help="Training a-priori LLR source: EXIT-style Gaussian, one detector->decoder pass, or mixed.")
    p.add_argument("--num-train-loops", type=int, default=5,
                   help="Number of untied detector/decoder loops rolled out during training; 2 recovers the old depth.")
    p.add_argument("--first-pass-bce-weight", type=float, default=1.0,
                   help="Auxiliary BCE weight on the no-prior first detector pass.")
    p.add_argument("--first-cal-bce-weight", type=float, default=0.5,
                   help="BCE weight on the calibrated first-pass LLR actually sent to the LDPC decoder.")
    p.add_argument("--first-brier-weight", type=float, default=0.5,
                   help="Brier-score calibration weight on the calibrated first-pass decoder input.")
    p.add_argument("--first-wrong-conf-weight", type=float, default=0.05,
                   help="Penalty weight for confident wrong first-pass decoder-input LLRs.")
    p.add_argument("--first-llr-mag-weight", type=float, default=1e-3,
                   help="Small L2 magnitude regularizer on raw first-pass post LLRs.")
    p.add_argument("--confidence-penalty-margin", type=float, default=0.0,
                   help="Margin for wrong-confidence penalty; 0 penalizes any wrong-direction confidence.")
    p.add_argument("--prior-tilt-bce-weight", type=float, default=1.0,
                   help="BCE weight on the second detector pass posterior after prior tilt.")
    p.add_argument("--second-ext-bce-weight", type=float, default=0.5,
                   help="BCE weight on the second detector pass extrinsic LLR sent to the LDPC decoder.")
    p.add_argument("--second-decoder-input", type=str, default="hybrid",
                   choices=["extrinsic", "posterior", "hybrid"],
                   help="Second-loop LDPC decoder input: pure extrinsic, pure posterior, or beta*ext+(1-beta)*post.")
    p.add_argument("--second-decoder-beta", type=float, default=0.25,
                   help="For second-decoder-input=hybrid: beta in beta*ext2+(1-beta)*post2.")
    p.add_argument("--second-decoder-bce-weight", type=float, default=0.5,
                   help="BCE weight on the actual second-loop LDPC decoder input LLR.")
    p.add_argument("--decoder-input-scale", type=float, default=0.5,
                   help="Scale applied to detector LLRs before every LDPC decoder call.")
    p.add_argument("--decoder-input-clip", type=float, default=2.0,
                   help="Clip detector LLRs before LDPC decoder input; <=0 disables this input clip.")
    p.add_argument("--decoder-prior-clip", type=float, default=3.0,
                   help="Clip decoder-derived prior LLRs before feeding them back to the detector; <=0 uses llr_clip.")
    p.add_argument("--listmap-teacher-weight", type=float, default=0.0,
                   help="Optional soft-teacher CE weight from K-best list-MAP; default off because it is expensive.")
    p.add_argument("--listmap-teacher-every", type=int, default=20,
                   help="When listmap-teacher-weight>0, compute teacher loss every N steps.")
    p.add_argument("--listmap-teacher-batch-size", type=int, default=8,
                   help="Max batch slice used for optional list-MAP teacher loss.")
    p.add_argument("--listmap-teacher-width", type=int, default=128,
                   help="Beam width for optional list-MAP teacher posterior.")
    p.add_argument("--posterior-aggregation", type=str, default="residual_softmax",
                   choices=["uniform", "residual_softmax", "best_residual"],
                   help="How K particles are merged into posterior LLRs.")
    p.add_argument("--posterior-weight-temperature", type=float, default=5.0,
                   help="Temperature for residual_softmax posterior aggregation; smaller is closer to best-candidate selection.")
    p.add_argument("--posterior-weight-bits", type=str, default="prob_hard", choices=["prob_hard", "sampled"],
                   help="Candidate bits used to score particle residuals for posterior aggregation and best-residual probes.")
    p.add_argument("--posterior-prior-coef", type=float, default=0.0,
                   help="Optional a-priori log-probability coefficient in particle weights; 0 uses channel residual only.")
    p.add_argument("--decoder-prior-damping-start", type=float, default=0.10,
                   help="Decoder-prior scale while the first-pass detector BER is still high.")
    p.add_argument("--decoder-prior-damping-end", type=float, default=0.50,
                   help="Decoder-prior scale once the first-pass detector BER is low enough.")
    p.add_argument("--decoder-prior-ramp-ber-high", type=float, default=0.25,
                   help="Use decoder-prior-damping-start at or above this first-pass coded BER.")
    p.add_argument("--decoder-prior-ramp-ber-low", type=float, default=0.08,
                   help="Use decoder-prior-damping-end at or below this first-pass coded BER.")
    p.add_argument("--decoder-prior-prob", type=float, default=0.5,
                   help="For prior-source=mixed: probability of using decoder_onepass instead of Gaussian.")
    p.add_argument("--i-a-mode", type=str, default="uniform", choices=["uniform", "beta"])
    p.add_argument("--llr-clip", type=float, default=20.0)
    p.add_argument("--init-mode", type=str, default="lmmse", choices=["lmmse", "random"],
                   help="Initial solution for each detector particle/simulator.")
    p.add_argument("--log-every", type=int, default=20,
                   help="Record metrics, update PT curve files, and refresh plots every N training steps.")
    p.add_argument("--print-train-every", type=int, default=1,
                   help="Print lightweight per-step training BER metrics; <=0 disables console printing.")
    p.add_argument("--save-every", type=int, default=2000)
    p.add_argument("--test-every", type=int, default=20,
                   help="Run an on-the-fly two-pass detector/decoder test every N training steps; <=0 disables it.")
    p.add_argument("--test-batch-size", type=int, default=16,
                   help="Batch size for on-the-fly two-pass tests.")
    p.add_argument("--test-batches", type=int, default=4,
                   help="Number of batches for each on-the-fly two-pass test.")
    p.add_argument("--online-mix-betas", type=str, default="0,0.25,0.5,0.75,1",
                   help="Online decoder diagnostic for L=beta*ext2+(1-beta)*post2; 0=post2, 1=extrinsic.")
    p.add_argument("--online-ablation", action=argparse.BooleanOptionalAction, default=False,
                   help="During online tests, also compare cn-update and decoder LLR scale/clip settings.")
    p.add_argument("--online-ablation-cn-updates", type=str, default="minsum,boxplus-phi",
                   help="Comma-separated cn-update values for online decoder ablations.")
    p.add_argument("--online-ablation-scale-clips", type=str, default="0.25:1.0,0.35:1.5,0.5:2.0,0.75:2.0",
                   help="Comma-separated scale:clip pairs for online decoder ablations.")
    p.add_argument("--llr-conflict-threshold", type=float, default=1.0,
                   help="Threshold for online ext2-vs-prior confident sign-conflict diagnostics.")
    p.add_argument("--train-ber-trace-name", type=str, default="train_coded_ber_trace.pt",
                   help="PT filename for logged first/second-round train coded BER curves.")
    p.add_argument("--run-startup-benchmarks", action=argparse.BooleanOptionalAction, default=True,
                   help="Run ZF/LMMSE/list-MAP coded/info BER benchmarks before training.")
    p.add_argument("--benchmark-batch-size", type=int, default=64,
                   help="Batch size for startup detection benchmarks.")
    p.add_argument("--benchmark-batches", type=int, default=1,
                   help="Number of batches for startup detection benchmarks.")
    p.add_argument("--benchmark-loops", type=int, default=5,
                   help="Number of fixed-baseline detector/decoder loops printed before learning starts.")
    p.add_argument("--benchmark-hard-llr-mag", type=float, default=8.0,
                   help="Fixed internal LLR magnitude used when decoding hard ZF/LMMSE decisions.")
    p.add_argument("--listmap-width", type=int, default=128,
                   help="K-best beam width for startup list-MAP benchmark.")
    # Eval / IDD
    p.add_argument("--K-test", type=int, default=16,
                   help="Parallel detector particles for soft posterior averaging; no final candidate selection is used.")
    p.add_argument("--num-idd-iter", type=int, default=3)
    p.add_argument("--eval-snr-db", type=str, default="8,12,16,20,24")
    p.add_argument("--eval-batch-size", type=int, default=16)
    p.add_argument("--eval-batches", type=int, default=8)
    # Modes
    p.add_argument("--mode", type=str, default="all", choices=["all", "p0", "train", "eval"],
                   help="p0=sanity check only; train=Phase-1 training; eval=load+evaluate; all=p0+train+eval.")
    p.add_argument("--ckpt", type=str, default="", help="Checkpoint to load for eval mode.")
    return p


def main() -> None:
    args = build_argparser().parse_args()
    os.makedirs(args.out_dir, exist_ok=True)
    device = torch.device(args.device if (torch.cuda.is_available() or args.device == "cpu") else "cpu")
    set_seed(args.seed)

    if args.mode in ("all", "p0"):
        p0_sanity_check(args)
        if args.mode == "p0":
            return

    cfg = MIMOConfig(Nt=args.Nt, Nr=args.Nr, snr_db=args.snr_db)

    if args.mode in ("all", "train"):
        model, _coded_system, _cfg = train_phase1(args)
    else:  # eval
        model = build_detector_stack(args, cfg, device)
        ckpt_path = args.ckpt or os.path.join(args.out_dir, "soft_idd_phase1.pt")
        state = torch.load(ckpt_path, map_location=device)
        load_detector_stack_checkpoint(model, state)
        print(f"Loaded checkpoint {ckpt_path}")

    if args.mode in ("all", "eval"):
        print("\n=== Evaluating BER vs SNR ===")
        results = evaluate_ber_vs_snr(model, cfg, args, device)
        plot_ber_vs_snr(results, args.num_idd_iter, args.out_dir)

        print("\n=== Detector EXIT curve (loop-health diagnostic) ===")
        exit_curve = detector_exit_curve(model, MIMOConfig(Nt=args.Nt, Nr=args.Nr, snr_db=args.snr_db), args, device)
        plot_exit(exit_curve, args.out_dir)
        print("EXIT I_A:", [round(v, 2) for v in exit_curve["i_a"]])
        print("EXIT I_E:", [round(v, 3) for v in exit_curve["i_e"]])
        print(f"\nAll outputs written to {args.out_dir}")


if __name__ == "__main__":
    main()
