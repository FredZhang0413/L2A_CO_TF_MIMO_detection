            device,
        )
        init_bits = initialize_candidates(H, y, cfg.sigma2, args.K_train, mode=args.init_mode)

        # --- build detector a-priori LLRs for this batch ---
        prior_source = args.prior_source
        if prior_source == "mixed":
            use_decoder_prior = torch.rand((), device=device).item() < args.decoder_prior_prob
            prior_source = "decoder_onepass" if use_decoder_prior else "gaussian"

        i_a_mean = float("nan")
        first_pass_coded_ber = float("nan")
        first_best_residual_coded_ber = float("nan")
        first_oracle_best_coded_ber = float("nan")
        first_weight_ess = float("nan")
        decoder_prior_damping = float("nan")
        first_pass_bce: Optional[torch.Tensor] = None
        first_cal_bce: Optional[torch.Tensor] = None
        first_brier: Optional[torch.Tensor] = None
        first_wrong_conf: Optional[torch.Tensor] = None
        first_llr_mag: Optional[torch.Tensor] = None
        first_listmap_teacher_ce: Optional[torch.Tensor] = None
        if prior_source == "gaussian":
            # Classical EXIT-style synthetic prior. Efficient but context-agnostic.
            i_a = sample_i_a(args.batch_size, device, mode=args.i_a_mode)  # (B,)
            while i_a.dim() < coded_grid.dim():
                i_a = i_a.unsqueeze(-1)
            i_a_grid = i_a.expand_as(coded_grid)
            apriori_bulk = sample_apriori_llr(coded_grid, i_a_grid, llr_clip=args.llr_clip)
            apriori = coded_system.grid_to_detector_batch(apriori_bulk)
            i_a_mean = float(i_a.mean().item())
        elif prior_source == "decoder_onepass":
            # Context-aware, one-step detector->decoder prior. This approximates the
            # second detector iteration without rolling out a full IDD training loop.
            # The first pass is also supervised by BCE so the decoder-prior source
            # itself learns good no-prior soft outputs.
            out_first = detector_for_loop(model, 1)(
                H, y, cfg.sigma2, init_bits, apriori_llr=None, sample=True, llr_clip=args.llr_clip
            )
            first_pass_bce = population_bce_on_coded_bits(out_first["tilt_prob_per_layer"], coded_det)
            post0, first_weights, _first_energy = posterior_llr_from_detector_output(
                out_first,
                H,
                y,
                cfg.sigma2,
                args,
                apriori_llr=None,
            )
            post0_decoder = calibrate_detector_llr_for_decoder(post0, args)
            first_cal_bce = bce_on_coded_bits_from_llr(post0_decoder, coded_det)
            first_brier = brier_on_coded_bits_from_llr(post0_decoder, coded_det)
            first_wrong_conf = wrong_confidence_penalty_from_llr(
                post0_decoder,
                coded_det,
                margin=args.confidence_penalty_margin,
            )
            first_llr_mag = post0.pow(2).mean()
            first_listmap_teacher_ce = post0.new_tensor(0.0)
            if (
                args.listmap_teacher_weight > 0.0
                and args.listmap_teacher_every > 0
                and step % args.listmap_teacher_every == 0
            ):
                teacher_n = min(int(args.listmap_teacher_batch_size), H.shape[0])
                if teacher_n > 0:
                    with torch.no_grad():
                        teacher_prob1 = kbest_list_bit_posterior(
                            H[:teacher_n],
                            y[:teacher_n],
                            cfg.sigma2,
                            beam_width=args.listmap_teacher_width,
                        ).clamp(1e-5, 1.0 - 1e-5)
                    first_listmap_teacher_ce = F.binary_cross_entropy_with_logits(
                        -post0[:teacher_n],
                        teacher_prob1,
                    )
            with torch.no_grad():
                post0 = post0.clamp(-args.llr_clip, args.llr_clip)
                det_bits0 = (llr_to_bit_prob(post0) >= 0.5).float()
                first_pass_coded_ber = bit_error_rate(det_bits0, coded_det)
                first_weight_ess = weight_effective_particles(first_weights)
                first_best_residual_coded_ber, _first_best_e = best_residual_probe_ber(
                    out_first["final_tilt_prob"],
                    out_first["bits_per_layer"][-1],
                    H,
                    y,
                    cfg.sigma2,
                    coded_det,
                    bit_source=args.posterior_weight_bits,
                )
                first_oracle_best_coded_ber = oracle_best_probe_ber(
                    out_first["final_tilt_prob"],
                    out_first["bits_per_layer"][-1],
                    coded_det,
                    bit_source=args.posterior_weight_bits,
                )
                decoder_prior_damping = decoder_prior_damping_from_ber(first_pass_coded_ber, args)
                post0_decoder_bulk = coded_system.detector_batch_to_grid(post0_decoder.detach(), args.batch_size)
                apriori = decoder_training_prior_from_post(
                    coded_system,
                    post0_decoder_bulk,
                    llr_clip=args.llr_clip,
                    damping=decoder_prior_damping,
                    prior_clip=args.decoder_prior_clip,
                )
                apriori = coded_system.grid_to_detector_batch(apriori)
        else:
            raise ValueError(f"Unsupported prior_source: {args.prior_source}")
        apriori_abs_mean = float(apriori.detach().abs().mean().item())

        num_train_loops = max(2, int(args.num_train_loops))
        prior_tilt_bces: List[torch.Tensor] = []
        second_ext_bces: List[torch.Tensor] = []
        second_decoder_bces: List[torch.Tensor] = []
        out: Dict[str, torch.Tensor] = {}
        second_post_llr: torch.Tensor = apriori
        second_ext_llr: torch.Tensor = apriori
        second_decoder_llr: torch.Tensor = apriori
        second_weights: torch.Tensor = torch.empty(0, device=device)

        for loop_idx in range(2, num_train_loops + 1):
            apriori_abs_mean = float(apriori.detach().abs().mean().item())
            out = detector_for_loop(model, loop_idx)(
                H, y, cfg.sigma2, init_bits, apriori_llr=apriori, sample=True, llr_clip=args.llr_clip
            )

            # Same loss family as the old second loop, averaged over untied loops 2..N.
            loop_prior_tilt_bce = population_bce_on_coded_bits(out["tilt_prob_per_layer"], coded_det)
            second_post_llr, second_weights, _second_energy = posterior_llr_from_detector_output(
                out,
                H,
                y,
                cfg.sigma2,
                args,
                apriori_llr=apriori,
            )
            second_ext_llr = extrinsic_llr(second_post_llr, apriori, llr_clip=args.llr_clip)
            loop_second_ext_bce = bce_on_coded_bits_from_llr(second_ext_llr, coded_det)
            second_decoder_llr = second_decoder_input_llr(second_post_llr, second_ext_llr, args)
            loop_second_decoder_bce = bce_on_coded_bits_from_llr(second_decoder_llr, coded_det)

            prior_tilt_bces.append(loop_prior_tilt_bce)
            second_ext_bces.append(loop_second_ext_bce)
            second_decoder_bces.append(loop_second_decoder_bce)

            if loop_idx < num_train_loops:
                with torch.no_grad():
                    loop_bits = (llr_to_bit_prob(second_post_llr.detach()) >= 0.5).float()
                    loop_ber = bit_error_rate(loop_bits, coded_det)
                    decoder_prior_damping = decoder_prior_damping_from_ber(loop_ber, args)
                    decoder_input = calibrate_detector_llr_for_decoder(second_decoder_llr.detach(), args)
                    decoder_input_bulk = coded_system.detector_batch_to_grid(decoder_input, args.batch_size)
                    apriori_raw_bulk, _info_hat = coded_system.decode_to_apriori(decoder_input_bulk)
                    apriori_raw = coded_system.grid_to_detector_batch(apriori_raw_bulk)
                    apriori = damp_and_clip_decoder_prior(apriori_raw, decoder_prior_damping, args)

        prior_tilt_bce = torch.stack(prior_tilt_bces).mean()
        second_ext_bce = torch.stack(second_ext_bces).mean()
        second_decoder_bce = torch.stack(second_decoder_bces).mean()
        if first_pass_bce is None:
            first_pass_bce = prior_tilt_bce.new_tensor(0.0)
        if first_cal_bce is None:
            first_cal_bce = prior_tilt_bce.new_tensor(0.0)
        if first_brier is None:
            first_brier = prior_tilt_bce.new_tensor(0.0)
        if first_wrong_conf is None:
            first_wrong_conf = prior_tilt_bce.new_tensor(0.0)
        if first_llr_mag is None:
            first_llr_mag = prior_tilt_bce.new_tensor(0.0)
        if first_listmap_teacher_ce is None:
            first_listmap_teacher_ce = prior_tilt_bce.new_tensor(0.0)
        bce = (
            float(args.first_pass_bce_weight) * first_pass_bce
            + float(args.first_cal_bce_weight) * first_cal_bce
            + float(args.first_brier_weight) * first_brier
            + float(args.first_wrong_conf_weight) * first_wrong_conf
            + float(args.first_llr_mag_weight) * first_llr_mag
            + float(args.listmap_teacher_weight) * first_listmap_teacher_ce
            + float(args.prior_tilt_bce_weight) * prior_tilt_bce
            + float(args.second_ext_bce_weight) * second_ext_bce
            + float(args.second_decoder_bce_weight) * second_decoder_bce
        )
        final_residual_energy = residual_energy(out["bits_per_layer"][-1].detach(), H, y, cfg.sigma2).mean()
        residual_pg_loss = bce.new_tensor(0.0)
        residual_weight = 0.0
        bce_weight = 1.0

        if args.loss_mode == "pure_bce":
            loss = bce
        elif args.loss_mode == "residual_hybrid":
            residual_weight, bce_weight = residual_bce_curriculum_weights(
                step,
                args.metric_residual_until,
                args.metric_hybrid_from,
                args.metric_residual_floor,
            )
            residual_pg_loss, final_residual_energy, _score_mean = residual_policy_gradient_loss(
                out["bits_per_layer"],
                out["tilt_prob_per_layer"],
                out["logprob_per_layer"],
                coded_det,
                H,
                y,
                cfg.sigma2,
                residual_weight=residual_weight,
                bce_weight=bce_weight,
                advantage_clip=args.advantage_clip,
            )
            balanced_pg = residual_pg_loss / residual_pg_loss.detach().abs().clamp_min(1e-6)
            balanced_bce = bce / bce.detach().abs().clamp_min(1e-6)
            loss = residual_weight * balanced_pg + bce_weight * balanced_bce
        else:
            raise ValueError(f"Unsupported loss_mode: {args.loss_mode}")

        optimizer.zero_grad(set_to_none=True)
        loss.backward()
        nn.utils.clip_grad_norm_(model.parameters(), args.grad_clip)
        optimizer.step()

        with torch.no_grad():
            post = second_post_llr.detach()
            det_bits = (llr_to_bit_prob(post) >= 0.5).float()
            coded_ber = bit_error_rate(det_bits, coded_det)
            ext_bits = (llr_to_bit_prob(second_ext_llr.detach()) >= 0.5).float()
            second_ext_coded_ber = bit_error_rate(ext_bits, coded_det)
            second_ext_abs_mean = float(second_ext_llr.detach().abs().mean().item())
