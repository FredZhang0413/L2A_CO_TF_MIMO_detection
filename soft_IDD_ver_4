@torch.no_grad()
def evaluate_ber_vs_snr(
    model: nn.ModuleList,
    cfg_base: MIMOConfig,
    args,
    device: torch.device,
) -> Dict[str, object]:
    """Sweep SNR; report detector and post-LDPC coded-bit BER for several IDD iterations,
    plus LMMSE / ZF baselines. One CodedSystem per SNR (sigma2 differs)."""
    snr_list = [float(s) for s in args.eval_snr_db.split(",")]
    results: Dict[str, object] = {"snr_db": snr_list}
    det_ber_by_iter = {it: [] for it in range(1, args.num_idd_iter + 1)}
    dec_ber_by_iter = {it: [] for it in range(1, args.num_idd_iter + 1)}
    info_ber_by_iter = {it: [] for it in range(1, args.num_idd_iter + 1)}
    lmmse_ber: List[float] = []
    zf_ber: List[float] = []

    for snr in snr_list:
        cfg = MIMOConfig(Nt=cfg_base.Nt, Nr=cfg_base.Nr, snr_db=snr)
        coded_system = CodedSystem(
            cfg,
            coderate=args.coderate,
            num_bp_iter=args.bp_iter,
            device=device,
            cn_update=args.cn_update,
            num_periods=getattr(args, "coherence_periods", 1),
        )
        det_acc = {it: [] for it in det_ber_by_iter}
        dec_acc = {it: [] for it in dec_ber_by_iter}
        info_acc = {it: [] for it in info_ber_by_iter}
        lm_acc: List[float] = []
        zf_acc: List[float] = []

        n_batches = max(1, args.eval_batches)
        for _ in range(n_batches):
            info_bits, coded_grid, H_bulk, y_bulk, H, y, coded_det = generate_transmission_batch(
                coded_system,
                cfg,
                args.eval_batch_size,
                device,
            )

            idd = run_idd_inference(
                model, coded_system, H_bulk, y_bulk, coded_grid, info_bits, cfg,
                K=args.K_test, num_idd_iter=args.num_idd_iter, init_mode=args.init_mode, args=args,
            )
            for it in det_ber_by_iter:
                det_acc[it].append(idd["det_coded_ber"][it - 1])
                dec_acc[it].append(idd["dec_coded_ber"][it - 1])
                info_acc[it].append(idd["dec_info_ber"][it - 1])

            lm_bits = linear_detector_bits(H, y, cfg.sigma2, kind="lmmse")
            zf_bits = linear_detector_bits(H, y, cfg.sigma2, kind="zf")
            lm_acc.append(bit_error_rate(lm_bits, coded_det))
            zf_acc.append(bit_error_rate(zf_bits, coded_det))

        for it in det_ber_by_iter:
            det_ber_by_iter[it].append(float(np.mean(det_acc[it])))
            dec_ber_by_iter[it].append(float(np.mean(dec_acc[it])))
            info_vals = np.asarray(info_acc[it], dtype=float)
            if np.isnan(info_vals).all():
                info_ber_by_iter[it].append(float("nan"))
            else:
                info_ber_by_iter[it].append(float(np.nanmean(info_vals)))
        lmmse_ber.append(float(np.mean(lm_acc)))
        zf_ber.append(float(np.mean(zf_acc)))
        print(f"SNR={snr:5.1f} dB | det_BER(it1)={det_ber_by_iter[1][-1]:.3e} "
              f"det_BER(itN)={det_ber_by_iter[args.num_idd_iter][-1]:.3e} "
              f"dec_BER(itN)={dec_ber_by_iter[args.num_idd_iter][-1]:.3e} "
              f"LMMSE={lmmse_ber[-1]:.3e}")

    results.update({
        "det_ber_by_iter": det_ber_by_iter,
        "dec_ber_by_iter": dec_ber_by_iter,
        "info_ber_by_iter": info_ber_by_iter,
        "lmmse_ber": lmmse_ber,
        "zf_ber": zf_ber,
    })
    return results


@torch.no_grad()
def detector_exit_curve(
    model: nn.ModuleList,
    cfg: MIMOConfig,
    args,
    device: torch.device,
    i_a_grid_points: int = 11,
) -> Dict[str, List[float]]:
    """Measure the detector's EXIT transfer I_E vs I_A using the consistent-Gaussian model.

    For each I_A: synthesize a-priori LLRs, run one detector pass, compute extrinsic LLRs,
    and estimate the extrinsic mutual information I_E via the J-function of the extrinsic
    LLR's empirical consistent-Gaussian std (sign-corrected by the true bits). A monotone,
    not-too-steep curve indicates healthy (no double-counting) information transfer.
    """
    model.eval()
    coded_system = CodedSystem(
        cfg,
        coderate=args.coderate,
        num_bp_iter=args.bp_iter,
        device=device,
        cn_update=args.cn_update,
        num_periods=getattr(args, "coherence_periods", 1),
    )
    i_a_axis = [i / (i_a_grid_points - 1) for i in range(i_a_grid_points)]
    i_e_axis: List[float] = []

    for i_a_val in i_a_axis:
        _info_bits, _coded_grid, _H_bulk, _y_bulk, H, y, coded_det = generate_transmission_batch(
            coded_system,
            cfg,
            args.eval_batch_size,
            device,
        )
        i_a_t = torch.full_like(coded_det, i_a_val)
        apriori = sample_apriori_llr(coded_det, i_a_t, llr_clip=args.llr_clip)
        init_bits = initialize_candidates(H, y, cfg.sigma2, args.K_test, mode=args.init_mode)
        out = detector_for_loop(model, 1)(H, y, cfg.sigma2, init_bits, apriori_llr=apriori, sample=True)
        post, _weights, _energy = posterior_llr_from_detector_output(out, H, y, cfg.sigma2, args, apriori_llr=apriori)
        ext = extrinsic_llr(post, apriori)
        # Sign-correct by true bits: z = (1-2b) * L_E should be > 0 on average; its
        # consistent-Gaussian std maps back to mutual information via J(.).
        sign = 1.0 - 2.0 * coded_det
        z = sign * ext
        sigma_eff = z.mean().clamp_min(1e-4).sqrt() * math.sqrt(2.0)  # mu = sigma^2/2 -> sigma = sqrt(2 mu)
        i_e = float(j_function(sigma_eff.reshape(1)).item())
        i_e_axis.append(i_e)

    return {"i_a": i_a_axis, "i_e": i_e_axis}


# =============================================================================
# P0 sanity check: coded round-trip with an EXACT soft demapper (no neural detector).
# Catches LLR sign/scale convention bugs before the detector is trusted.
# =============================================================================


@torch.no_grad()
def exact_soft_demap_llr(H: torch.Tensor, y: torch.Tensor, sigma2: float) -> torch.Tensor:
    """Per-stream max-log per-bit LLRs for 256-QAM under y = Hx + n.

    Returns L = log p(b=0)/p(b=1) of shape (B, Nt, 8). This is exact for decoupled
    streams (e.g. identity/diagonal H). For dense random MIMO it is an approximate
    per-stream demapper: the other streams are hard-cancelled using the LMMSE estimate,
    then each stream is marginalized over the 256-QAM constellation.
    """
    B, Nr, Nt = H.shape
    device = H.device
    const_bits, const_syms = qam_constellation(device)  # (256,8), (256,)
    x_lmmse = bits_to_qam(linear_detector_bits(H, y, sigma2, kind="lmmse"))  # (B,Nt)

    llr = torch.zeros(B, Nt, BITS_PER_SYMBOL, device=device)
    for i in range(Nt):
        # Cancel interference from the other streams using the LMMSE hard estimate.
        interf = torch.matmul(H, x_lmmse[..., None]).squeeze(-1) - H[:, :, i] * x_lmmse[:, i][:, None]
        yi = y - interf  # (B, Nr)
        hi = H[:, :, i]  # (B, Nr)
        # Distance to each constellation point for stream i.
        diff = yi[:, None, :] - hi[:, None, :] * const_syms[None, :, None]
        metric = -(diff.abs() ** 2).sum(dim=-1).real / sigma2  # (B, 256) log-likelihood
        for b in range(BITS_PER_SYMBOL):
            mask0 = (const_bits[:, b] == 0.0)
            m0 = metric[:, mask0].max(dim=1).values
            m1 = metric[:, ~mask0].max(dim=1).values
            llr[:, i, b] = m0 - m1  # log p0/p1 (max-log)
    return llr


@torch.no_grad()
def p0_sanity_check(args) -> None:
    """Check LDPC LLR convention and the controlled demap/decode round-trip.

    The full 8x8 256-QAM random-MIMO APP demapper is too large for an exact P0 gate
    (256^8 joint states). Therefore this sanity check separates:
      1) perfect-LLR LDPC sign/interleaver gate,
      2) identity-channel exact per-stream demapper gate,
      3) random-MIMO approximate-demapper probe.
    """
    device = torch.device(args.device if (torch.cuda.is_available() or args.device == "cpu") else "cpu")
    set_seed(args.seed)
    print("\n=== P0 sanity check: LDPC sign + controlled soft-demapper round-trip ===")
    cfg0 = MIMOConfig(Nt=args.Nt, Nr=args.Nr, snr_db=20.0)
    cs0 = CodedSystem(
        cfg0,
        coderate=args.coderate,
        num_bp_iter=args.bp_iter,
        device=device,
        cn_update=args.cn_update,
        num_periods=getattr(args, "coherence_periods", 1),
    )
    info0, coded0 = cs0.generate_coded_grid(args.eval_batch_size)
    perfect_llr = (1.0 - 2.0 * coded0) * args.llr_clip  # internal convention: log p0/p1
    _, info_hat0 = cs0.decode_to_apriori(perfect_llr)
    print(f"Perfect-LLR LDPC gate | post-LDPC info_BER={bit_error_rate(info_hat0, info0):.3e}")

    for snr in [float(s) for s in args.eval_snr_db.split(",")]:
        cfg = MIMOConfig(Nt=args.Nt, Nr=args.Nr, snr_db=snr)
        cs = CodedSystem(
            cfg,
            coderate=args.coderate,
            num_bp_iter=args.bp_iter,
            device=device,
            cn_update=args.cn_update,
            num_periods=getattr(args, "coherence_periods", 1),
        )
        info_bits, coded_grid = cs.generate_coded_grid(args.eval_batch_size)

        # Controlled channel: H=I makes the per-stream 256-QAM demapper exact and
        # isolates LDPC/LLR convention from random-MIMO detector quality.
        if cs.num_periods == 1:
            H_eye = torch.zeros(args.eval_batch_size, cfg.Nr, cfg.Nt, dtype=torch.complex64, device=device)
        else:
            H_eye = torch.zeros(
                args.eval_batch_size,
                cs.num_periods,
                cfg.Nr,
                cfg.Nt,
                dtype=torch.complex64,
                device=device,
            )
        diag_len = min(cfg.Nr, cfg.Nt)
        diag_idx = torch.arange(diag_len, device=device)
        H_eye[..., diag_idx, diag_idx] = 1.0 + 0.0j
        x = bits_to_qam(coded_grid)
        noise = complex_normal(x.shape[:-1] + (cfg.Nr,), device=device, scale=math.sqrt(cfg.sigma2))
        y_eye = torch.matmul(H_eye, x[..., None]).squeeze(-1) + noise
        H_det, y_det, coded_det, _B, _P = flatten_periods_for_detector(H_eye, y_eye, coded_grid)
        if coded_det is None:
            raise RuntimeError("P0 identity probe requires coded bits.")
        llr = exact_soft_demap_llr(H_det, y_det, cfg.sigma2)  # flattened (B*P,Nt,8) log p0/p1
        det_bits = (llr_to_bit_prob(llr) >= 0.5).float()
        det_ber = bit_error_rate(det_bits, coded_det)
        llr_bulk = cs.detector_batch_to_grid(llr, args.eval_batch_size)
        _, info_hat = cs.decode_to_apriori(llr_bulk)
        info_ber = bit_error_rate(info_hat, info_bits) if cs.sionna else float("nan")
        print(f"Identity H SNR={snr:5.1f} dB | demap coded_BER={det_ber:.3e} | post-LDPC info_BER={info_ber:.3e}")

    print("\n--- Random-MIMO approximate demapper probe (not a pass/fail P0 gate) ---")
    for snr in [float(s) for s in args.eval_snr_db.split(",")]:
        cfg = MIMOConfig(Nt=args.Nt, Nr=args.Nr, snr_db=snr)
        cs = CodedSystem(
            cfg,
            coderate=args.coderate,
            num_bp_iter=args.bp_iter,
            device=device,
            cn_update=args.cn_update,
            num_periods=getattr(args, "coherence_periods", 1),
        )
        info_bits, coded_grid, _H_bulk, _y_bulk, H, y, coded_det = generate_transmission_batch(
            cs,
            cfg,
            args.eval_batch_size,
            device,
        )
        llr = exact_soft_demap_llr(H, y, cfg.sigma2)
        det_bits = (llr_to_bit_prob(llr) >= 0.5).float()
        det_ber = bit_error_rate(det_bits, coded_det)
        llr_bulk = cs.detector_batch_to_grid(llr, args.eval_batch_size)
        _, info_hat = cs.decode_to_apriori(llr_bulk)
        info_ber = bit_error_rate(info_hat, info_bits) if cs.sionna else float("nan")
        print(f"Random MIMO SNR={snr:5.1f} dB | approx demap coded_BER={det_ber:.3e} | post-LDPC info_BER={info_ber:.3e}")
    print("=== P0 passes if the perfect-LLR gate is 0 and identity-H post-LDPC info_BER -> 0 at high SNR. ===\n")


