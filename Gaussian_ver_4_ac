def set_seed(seed: int) -> None:
    random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def complex_normal(shape, device, dtype=torch.complex64, scale: float = 1.0) -> torch.Tensor:
    """Generate circular complex Gaussian samples CN(0, scale^2)."""
    real_dtype = torch.float32 if dtype == torch.complex64 else torch.float64
    x = torch.randn(*shape, device=device, dtype=real_dtype)
    y = torch.randn(*shape, device=device, dtype=real_dtype)
    return (scale / math.sqrt(2.0)) * (x + 1j * y)


# Gray-coded 4-PAM per real dimension:
# bits 00 -> -3, 01 -> -1, 11 -> +1, 10 -> +3
PAIR_TO_LEVEL = {
    (0, 0): -3,
    (0, 1): -1,
    (1, 1): +1,
    (1, 0): +3,
}
LEVEL_TO_PAIR = {
    -3: (0, 0),
    -1: (0, 1),
    +1: (1, 1),
    +3: (1, 0),
}
LEVELS = torch.tensor([-3.0, -1.0, 1.0, 3.0])
QAM_NORM = math.sqrt(10.0)


def bits_to_level(bits2: torch.Tensor) -> torch.Tensor:
    """Map two bits (..., 2) to Gray-coded 4-PAM levels in {-3,-1,+1,+3}."""
    b0 = bits2[..., 0].long()
    b1 = bits2[..., 1].long()
    idx = torch.empty_like(b0)
    idx[(b0 == 0) & (b1 == 0)] = 0
    idx[(b0 == 0) & (b1 == 1)] = 1
    idx[(b0 == 1) & (b1 == 1)] = 2
    idx[(b0 == 1) & (b1 == 0)] = 3
    return LEVELS.to(bits2.device)[idx]


def level_to_bits(levels: torch.Tensor) -> torch.Tensor:
    """Map nearest 4-PAM levels to Gray-coded two-bit labels."""
    levels_device = LEVELS.to(levels.device)
    dist = (levels[..., None] - levels_device) ** 2
    idx = dist.argmin(dim=-1)
    out = torch.zeros(*levels.shape, 2, device=levels.device, dtype=torch.float32)
    out[idx == 0] = torch.tensor([0.0, 0.0], device=levels.device)
    out[idx == 1] = torch.tensor([0.0, 1.0], device=levels.device)
    out[idx == 2] = torch.tensor([1.0, 1.0], device=levels.device)
    out[idx == 3] = torch.tensor([1.0, 0.0], device=levels.device)
    return out


def bits_to_qam(bits: torch.Tensor) -> torch.Tensor:
    """Map bits (..., Nt, 4) to normalized 16-QAM symbols (..., Nt)."""
    real_level = bits_to_level(bits[..., 0:2])
    imag_level = bits_to_level(bits[..., 2:4])
    return (real_level + 1j * imag_level).to(torch.complex64) / QAM_NORM


def qam_to_bits(x: torch.Tensor) -> torch.Tensor:
    """Hard-slice complex symbols to normalized 16-QAM and return bits (..., Nt, 4)."""
    xr = (x.real * QAM_NORM).clamp(-3.0, 3.0)
    xi = (x.imag * QAM_NORM).clamp(-3.0, 3.0)
    br = level_to_bits(xr)
    bi = level_to_bits(xi)
    return torch.cat([br, bi], dim=-1)


def qam_slice(x: torch.Tensor) -> torch.Tensor:
    """Hard-slice complex symbols to normalized 16-QAM points."""
    return bits_to_qam(qam_to_bits(x))


def qam_constellation(device: torch.device) -> Tuple[torch.Tensor, torch.Tensor]:
    """Return all 16 valid Gray-labeled 16-QAM bit labels and symbols."""
    bits = torch.tensor(
        [[(idx >> bit) & 1 for bit in (3, 2, 1, 0)] for idx in range(16)],
        device=device,
        dtype=torch.float32,
    )
    symbols = bits_to_qam(bits.view(16, 1, 4)).view(16)
    return bits, symbols


def residual_energy(bits: torch.Tensor, H: torch.Tensor, y: torch.Tensor, sigma2: float) -> torch.Tensor:
    """Normalized residual energy f(b;G) = ||y - H M(b)||^2 / (Nr sigma^2)."""
    if bits.dim() == 4:
        B, K, Nt, _ = bits.shape
        x = bits_to_qam(bits)
        H_expand = H[:, None, :, :]
        pred = torch.matmul(H_expand, x[..., None]).squeeze(-1)
        err = y[:, None, :] - pred
        Nr = H.shape[1]
        return (err.abs() ** 2).sum(dim=-1).real / (Nr * sigma2)
    elif bits.dim() == 3:
        x = bits_to_qam(bits)
        pred = torch.matmul(H, x[..., None]).squeeze(-1)
        err = y - pred
        Nr = H.shape[1]
        return (err.abs() ** 2).sum(dim=-1).real / (Nr * sigma2)
    raise ValueError(f"Unsupported bits dimension: {bits.shape}")


def bit_error_rate(pred_bits: torch.Tensor, true_bits: torch.Tensor) -> float:
    return (pred_bits.round().long() != true_bits.round().long()).float().mean().item()


