@dataclass
class MIMOConfig:
    Nt: int = 32
    Nr: int = 32
    snr_db: float = 15.0

    @property
    def sigma2(self) -> float:
        return 10.0 ** (-self.snr_db / 10.0)


def generate_batch(batch_size: int, cfg: MIMOConfig, device: torch.device) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
    """Return H, y, true_bits, true_x."""
    H = complex_normal((batch_size, cfg.Nr, cfg.Nt), device=device, scale=1.0 / math.sqrt(cfg.Nt))
    true_bits = torch.randint(0, 2, (batch_size, cfg.Nt, BITS_PER_SYMBOL), device=device).float()
    x = bits_to_qam(true_bits)
    noise = complex_normal((batch_size, cfg.Nr), device=device, scale=math.sqrt(cfg.sigma2))
    y = torch.matmul(H, x[..., None]).squeeze(-1) + noise
    return H, y, true_bits, x


def linear_detector_bits(H: torch.Tensor, y: torch.Tensor, sigma2: float, kind: str = "lmmse") -> torch.Tensor:
    """ZF or LMMSE hard-sliced bit estimates."""
    B, Nr, Nt = H.shape
    Hh = H.conj().transpose(-1, -2)
    R = torch.matmul(Hh, H)
    z = torch.matmul(Hh, y[..., None]).squeeze(-1)
    eye = torch.eye(Nt, device=H.device, dtype=H.dtype)[None, :, :]
    if kind.lower() == "lmmse":
        A = R + sigma2 * eye
    elif kind.lower() == "zf":
        A = R + 1e-8 * eye
    else:
        raise ValueError("kind must be 'zf' or 'lmmse'")
    x_hat = torch.linalg.solve(A, z[..., None]).squeeze(-1)
    return qam_to_bits(x_hat)


@torch.no_grad()
def exact_ml_sphere_decode_bits(H: torch.Tensor, y: torch.Tensor, sigma2: float) -> torch.Tensor:
    """Exact finite-alphabet ML detection using QR sphere decoding.

    The branch-and-bound search enumerates 16-QAM symbols in Schnorr-Euchner
    order and uses the LMMSE hard slice as an initial radius. This benchmark is
    intended for a small fixed test subset rather than every validation batch.
    """
    H_cpu = H.detach().to(device="cpu", dtype=torch.complex128)
    y_cpu = y.detach().to(device="cpu", dtype=torch.complex128)
    const_bits, const_symbols = qam_constellation(torch.device("cpu"))
    const_symbols = const_symbols.to(torch.complex128)
    B, _, Nt = H_cpu.shape
    detected: List[torch.Tensor] = []

    for batch_idx in range(B):
        Hb = H_cpu[batch_idx]
        yb = y_cpu[batch_idx]
        Q, R = torch.linalg.qr(Hb, mode="reduced")
        y_tilde = Q.conj().transpose(-1, -2) @ yb

        Hh = Hb.conj().transpose(-1, -2)
        eye = torch.eye(Nt, dtype=torch.complex128)
        x_lmmse = torch.linalg.solve(Hh @ Hb + sigma2 * eye, Hh @ yb)
        best_x = qam_slice(x_lmmse.to(torch.complex64)).to(torch.complex128)
        best_metric = float(((yb - Hb @ best_x).abs() ** 2).sum().real.item())
        work_x = best_x.clone()

        def search(level: int, partial_metric: float) -> None:
            nonlocal best_metric, best_x
            if level < 0:
                best_metric = partial_metric
                best_x = work_x.clone()
                return

            interference = (R[level, level + 1 :] @ work_x[level + 1 :]) if level + 1 < Nt else 0.0
            target = y_tilde[level] - interference
            branch_metric = ((target - R[level, level] * const_symbols).abs() ** 2).real
            for symbol_idx in torch.argsort(branch_metric).tolist():
                candidate_metric = partial_metric + float(branch_metric[symbol_idx].item())
                if candidate_metric <= best_metric + 1e-12:
                    work_x[level] = const_symbols[symbol_idx]
                    search(level - 1, candidate_metric)

        search(Nt - 1, 0.0)
        detected.append(qam_to_bits(best_x.to(torch.complex64).view(1, Nt)).squeeze(0))

    return torch.stack(detected, dim=0).to(H.device)


@torch.no_grad()
def evaluate_exact_ml_baseline(
    H: torch.Tensor,
    y: torch.Tensor,
    true_bits: torch.Tensor,
    sigma2: float,
) -> Dict[str, float]:
    ml_bits = exact_ml_sphere_decode_bits(H, y, sigma2)
    return {
        "ber": bit_error_rate(ml_bits, true_bits),
        "residual_energy": residual_energy(ml_bits, H, y, sigma2).mean().item(),
    }


@torch.no_grad()
def kbest_ml_surrogate_bits(H: torch.Tensor, y: torch.Tensor, beam_width: int = 256) -> torch.Tensor:
    """Lower-complexity branch-search surrogate for ML detection.

    This is a QR-domain K-best tree search. It keeps the best ``beam_width``
    partial symbol vectors at each layer, so it is not exact ML, but it is a
    much stronger finite-alphabet reference than one-shot linear slicing.
    """
    H_cpu = H.detach().to(device="cpu", dtype=torch.complex128)
    y_cpu = y.detach().to(device="cpu", dtype=torch.complex128)
    _, const_symbols = qam_constellation(torch.device("cpu"))
    const_symbols = const_symbols.to(torch.complex128)
    B, _, Nt = H_cpu.shape
    beam_width = max(1, int(beam_width))
    detected: List[torch.Tensor] = []

    for batch_idx in range(B):
        Hb = H_cpu[batch_idx]
        yb = y_cpu[batch_idx]
        Q, R = torch.linalg.qr(Hb, mode="reduced")
        y_tilde = Q.conj().transpose(-1, -2) @ yb
        paths = torch.zeros(1, Nt, dtype=torch.complex128)
        metrics = torch.zeros(1, dtype=torch.float64)

        for level in range(Nt - 1, -1, -1):
            if level + 1 < Nt:
                interference = (paths[:, level + 1 :] * R[level, level + 1 :]).sum(dim=1)
            else:
                interference = torch.zeros(paths.shape[0], dtype=torch.complex128)
            target = y_tilde[level] - interference
            branch_metric = ((target[:, None] - R[level, level] * const_symbols[None, :]).abs() ** 2).real
            candidate_metric = metrics[:, None] + branch_metric
            flat_metric = candidate_metric.reshape(-1)
            keep = min(beam_width, flat_metric.numel())
            best_metric, best_flat = torch.topk(flat_metric, keep, largest=False)
            parent_idx = torch.div(best_flat, const_symbols.numel(), rounding_mode="floor")
            symbol_idx = best_flat.remainder(const_symbols.numel())
            paths = paths[parent_idx].clone()
            paths[:, level] = const_symbols[symbol_idx]
            metrics = best_metric

        detected.append(qam_to_bits(paths[metrics.argmin()].to(torch.complex64).view(1, Nt)).squeeze(0))

    return torch.stack(detected, dim=0).to(H.device)


@torch.no_grad()
def kbest_list_bit_posterior(H: torch.Tensor, y: torch.Tensor, sigma2: float, beam_width: int = 256) -> torch.Tensor:
    """Approximate bit posterior marginals from a K-best 16-QAM list.

    The QR tree search keeps a list of low-distance complete 16-QAM vectors.
    It then forms approximate bit posterior marginals over the retained list:
    P(b_j=1|y,H) ~= sum_{x in list, b_j(x)=1} exp(-||y-Hx||^2/sigma2)
                  / sum_{x in list} exp(-||y-Hx||^2/sigma2).
    """
    H_cpu = H.detach().to(device="cpu", dtype=torch.complex128)
    y_cpu = y.detach().to(device="cpu", dtype=torch.complex128)
    _, const_symbols = qam_constellation(torch.device("cpu"))
    const_symbols = const_symbols.to(torch.complex128)
    B, _, Nt = H_cpu.shape
    beam_width = max(1, int(beam_width))
    posteriors: List[torch.Tensor] = []

    for batch_idx in range(B):
        Hb = H_cpu[batch_idx]
        yb = y_cpu[batch_idx]
        Q, R = torch.linalg.qr(Hb, mode="reduced")
        y_tilde = Q.conj().transpose(-1, -2) @ yb
        paths = torch.zeros(1, Nt, dtype=torch.complex128)
        metrics = torch.zeros(1, dtype=torch.float64)

        for level in range(Nt - 1, -1, -1):
            if level + 1 < Nt:
                interference = (paths[:, level + 1 :] * R[level, level + 1 :]).sum(dim=1)
            else:
                interference = torch.zeros(paths.shape[0], dtype=torch.complex128)
            target = y_tilde[level] - interference
            branch_metric = ((target[:, None] - R[level, level] * const_symbols[None, :]).abs() ** 2).real
            candidate_metric = metrics[:, None] + branch_metric
            flat_metric = candidate_metric.reshape(-1)
            keep = min(beam_width, flat_metric.numel())
            best_metric, best_flat = torch.topk(flat_metric, keep, largest=False)
            parent_idx = torch.div(best_flat, const_symbols.numel(), rounding_mode="floor")
            symbol_idx = best_flat.remainder(const_symbols.numel())
            paths = paths[parent_idx].clone()
            paths[:, level] = const_symbols[symbol_idx]
            metrics = best_metric

        list_bits = qam_to_bits(paths.to(torch.complex64).view(paths.shape[0], Nt))  # (L, Nt, 6)
        log_weights = -metrics / max(float(sigma2), 1e-12)
        log_weights = log_weights - log_weights.max()
        weights = torch.exp(log_weights).view(-1, 1, 1).to(list_bits.dtype)
        posterior_one = (weights * list_bits).sum(dim=0) / weights.sum().clamp_min(1e-30)
        posteriors.append(posterior_one.float())

    return torch.stack(posteriors, dim=0).to(H.device)


@torch.no_grad()
def kbest_list_bit_map_bits(H: torch.Tensor, y: torch.Tensor, sigma2: float, beam_width: int = 256) -> torch.Tensor:
    """K-best list detector with bit-wise MAP hard decisions."""
    posterior_one = kbest_list_bit_posterior(H, y, sigma2, beam_width=beam_width)
    return (posterior_one >= 0.5).float()


def posterior_disagreement_penalty(bits: torch.Tensor, posterior_one: torch.Tensor) -> torch.Tensor:
    """Cross-entropy penalty between candidate hard bits and list-MAP posterior.

    bits: (B, K, Nt, 4)
    posterior_one: (B, Nt, 4), approximate P(bit=1|y,H)
    returns: (B, K), summed bit-wise CE. Lower means better BER-oriented agreement.
    """
    p = posterior_one[:, None, :, :].clamp(1e-5, 1.0 - 1e-5)
    b = bits.float()
    ce = -(b * torch.log(p) + (1.0 - b) * torch.log(1.0 - p))
    return ce.sum(dim=(-1, -2))


@torch.no_grad()
def evaluate_ml_reference(
    H: torch.Tensor,
    y: torch.Tensor,
    true_bits: torch.Tensor,
    sigma2: float,
    mode: str,
    beam_width: int,
) -> Dict[str, float | str]:
    if mode == "listmap":
        bits = kbest_list_bit_map_bits(H, y, sigma2, beam_width=beam_width)
        label = f"listmap{int(beam_width)}"
    elif mode == "exact":
        bits = exact_ml_sphere_decode_bits(H, y, sigma2)
        label = "exact"
    elif mode == "kbest":
        bits = kbest_ml_surrogate_bits(H, y, beam_width=beam_width)
        label = f"kbest{int(beam_width)}"
    else:
        raise ValueError(f"Unsupported ML reference mode: {mode}")
    return {
        "ber": bit_error_rate(bits, true_bits),
        "residual_energy": residual_energy(bits, H, y, sigma2).mean().item(),
        "mode": label,
    }


def neighbor_perturb_bits(bits: torch.Tensor, p_symbol: float = 0.25) -> torch.Tensor:
    """Perturb each selected 16-QAM symbol to a valid neighboring constellation point.

    The perturbation changes either the real-axis or imaginary-axis 4-PAM level by one step.
    This preserves constellation validity and searches adjacent valid points.

    bits shape: (B, Nt, 4)
    """
    device = bits.device
    out = bits.clone()
    B, Nt, _ = bits.shape
    perturb_mask = torch.rand(B, Nt, device=device) < p_symbol

    # Convert current bits to level indices 0..7 for real and imag axes.
    real_level = bits_to_level(out[..., 0:AXIS_BITS])
    imag_level = bits_to_level(out[..., AXIS_BITS:BITS_PER_SYMBOL])
    levels_device = LEVELS.to(device)
    max_level_idx = levels_device.numel() - 1
    real_idx = ((real_level[..., None] - levels_device) ** 2).argmin(dim=-1)
    imag_idx = ((imag_level[..., None] - levels_device) ** 2).argmin(dim=-1)

    choose_real = torch.rand(B, Nt, device=device) < 0.5
    step = torch.where(torch.rand(B, Nt, device=device) < 0.5, -torch.ones(B, Nt, device=device, dtype=torch.long), torch.ones(B, Nt, device=device, dtype=torch.long))

    def valid_move(idx, st):
        # If a boundary move would leave the constellation, reverse it.
        st = torch.where((idx == 0) & (st < 0), torch.ones_like(st), st)
        st = torch.where((idx == max_level_idx) & (st > 0), -torch.ones_like(st), st)
        return (idx + st).clamp(0, max_level_idx)

    new_real_idx = valid_move(real_idx, step)
    new_imag_idx = valid_move(imag_idx, step)

    new_real_levels = levels_device[new_real_idx]
    new_imag_levels = levels_device[new_imag_idx]
    new_real_bits = level_to_bits(new_real_levels)
    new_imag_bits = level_to_bits(new_imag_levels)

    use_real = perturb_mask & choose_real
    use_imag = perturb_mask & (~choose_real)
    out[..., 0:AXIS_BITS] = torch.where(use_real[..., None], new_real_bits, out[..., 0:AXIS_BITS])
    out[..., AXIS_BITS:BITS_PER_SYMBOL] = torch.where(use_imag[..., None], new_imag_bits, out[..., AXIS_BITS:BITS_PER_SYMBOL])
    return out


def initialize_simulators(
    H: torch.Tensor,
    y: torch.Tensor,
    sigma2: float,
    K: int,
    p_symbol: float,
    strong_p_symbol: float = 0.6,
) -> torch.Tensor:
    """Create K fully random valid 16-QAM simulator states.

    The channel and perturbation arguments are intentionally unused here. They
    are kept in the signature so training/evaluation call sites can stay shared
    with older LMMSE-anchored variants.
    """
    del y, sigma2, p_symbol, strong_p_symbol
    B, _, Nt = H.shape
    return torch.randint(0, 2, (B, K, Nt, BITS_PER_SYMBOL), device=H.device).float()


@torch.no_grad()
def local_search_refine_bits(
    bits: torch.Tensor,
    H: torch.Tensor,
    y: torch.Tensor,
    sigma2: float,
    sweeps: int = 1,
    multi_rounds: int = 2,
    topk_symbols: int = 2,
    posterior_one: Optional[torch.Tensor] = None,
    posterior_alpha: float = 0.0,
) -> torch.Tensor:
    """Two-phase greedy Gray-neighbor local search for 16-QAM solutions.

    By default, this is the original energy-greedy local search. If
    ``posterior_one`` and ``posterior_alpha`` are supplied, the accept/selection
    score becomes

        residual_energy + posterior_alpha * bitwise_CE(candidate, posterior),

    where the CE term is normalized per symbol. This implements a BER-aware
    local-search proxy without using true bits at inference time. ``posterior_one``
    may be shaped as (B, Nt, 4) for one posterior per channel instance, or
    (B, K, Nt, 4) for simulator-specific posteriors.
    """
    if sweeps <= 0 and multi_rounds <= 0:
        return bits

    B, K, Nt, _ = bits.shape
    Nr = H.shape[1]
    device = bits.device
    levels = LEVELS.to(device)
    max_level_idx = levels.numel() - 1
    delta_real = torch.tensor([-1, 1, 0, 0], device=device, dtype=torch.long)
    delta_imag = torch.tensor([0, 0, -1, 1], device=device, dtype=torch.long)

    x = bits_to_qam(bits.float())  # (B, K, Nt)
    H_expand = H[:, None, :, :]  # (B, 1, Nr, Nt)
    residual = y[:, None, :] - torch.matmul(H_expand, x[..., None]).squeeze(-1)  # (B, K, Nr)

    real_level = bits_to_level(bits[..., 0:AXIS_BITS])
    imag_level = bits_to_level(bits[..., AXIS_BITS:BITS_PER_SYMBOL])
    real_idx = ((real_level[..., None] - levels) ** 2).argmin(dim=-1)
    imag_idx = ((imag_level[..., None] - levels) ** 2).argmin(dim=-1)
    h_norm_sq = (H.abs() ** 2).sum(dim=1).real  # (B, Nt)

    use_posterior_score = posterior_one is not None and abs(float(posterior_alpha)) > 0.0
    posterior: Optional[torch.Tensor]
    if use_posterior_score:
        posterior = posterior_one.to(device=device, dtype=torch.float32).clamp(1e-5, 1.0 - 1e-5)
        if posterior.dim() == 3:
            posterior = posterior[:, None, :, :].expand(B, K, Nt, BITS_PER_SYMBOL).contiguous()
        elif posterior.dim() == 4:
            if posterior.shape[:3] != (B, K, Nt):
                raise ValueError(f"posterior_one has incompatible shape: {posterior.shape}, expected (B,K,Nt,{BITS_PER_SYMBOL})")
        else:
            raise ValueError(f"posterior_one must have shape (B,Nt,{BITS_PER_SYMBOL}) or (B,K,Nt,{BITS_PER_SYMBOL}), got {posterior.shape}")
    else:
        posterior = None

    def ce_per_symbol(bits6: torch.Tensor, prob6: torch.Tensor) -> torch.Tensor:
        return -(bits6 * torch.log(prob6) + (1.0 - bits6) * torch.log(1.0 - prob6)).sum(dim=-1) / BITS_PER_SYMBOL

    def best_gray_move(i: int) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
        hi = H[:, :, i]  # (B, Nr)
        old_xi = x[:, :, i]  # (B, K)
        ri = real_idx[:, :, i]
        qi = imag_idx[:, :, i]
        valid_moves = torch.stack([ri > 0, ri < max_level_idx, qi > 0, qi < max_level_idx], dim=-1)
        new_ri = (ri[..., None] + delta_real).clamp(0, max_level_idx)
        new_qi = (qi[..., None] + delta_imag).clamp(0, max_level_idx)
        new_xi = ((levels[new_ri] + 1j * levels[new_qi]) / QAM_NORM).to(H.dtype)
        delta_x = new_xi - old_xi[..., None]
        hi_h_residual = (hi.conj()[:, None, :] * residual).sum(dim=-1)
        delta_energy = (
            (delta_x.abs() ** 2) * h_norm_sq[:, i, None, None]
            - 2.0 * torch.real(delta_x.conj() * hi_h_residual[..., None])
        ) / (Nr * sigma2)

        delta_ce = torch.zeros_like(delta_energy)
        if posterior is not None:
            p_i = posterior[:, :, i, :]  # (B, K, 6)
            old_bits6 = torch.cat([level_to_bits(levels[ri]), level_to_bits(levels[qi])], dim=-1).float()
            old_ce = ce_per_symbol(old_bits6, p_i)  # (B, K)
            new_bits6 = torch.cat([level_to_bits(levels[new_ri]), level_to_bits(levels[new_qi])], dim=-1).float()
            new_ce = ce_per_symbol(new_bits6, p_i[:, :, None, :].expand_as(new_bits6))  # (B, K, 4)
            delta_ce = new_ce - old_ce[..., None]

        delta_score = delta_energy + float(posterior_alpha) * delta_ce
        delta_score = delta_score.masked_fill(~valid_moves, float("inf"))
        delta_energy = delta_energy.masked_fill(~valid_moves, float("inf"))
        delta_ce = delta_ce.masked_fill(~valid_moves, 0.0)
        best_delta_score, best_move = delta_score.min(dim=-1)
        gather_idx = best_move[..., None]
        best_delta_energy = delta_energy.gather(dim=-1, index=gather_idx).squeeze(-1)
        best_delta_ce = delta_ce.gather(dim=-1, index=gather_idx).squeeze(-1)
        best_delta_x = delta_x.gather(dim=-1, index=gather_idx).squeeze(-1)
        best_ri = new_ri.gather(dim=-1, index=gather_idx).squeeze(-1)
        best_qi = new_qi.gather(dim=-1, index=gather_idx).squeeze(-1)
        return best_delta_score, best_delta_energy, best_delta_ce, best_delta_x, best_ri, best_qi

    num_multi = max(0, int(multi_rounds))
    num_hops = min(max(0, int(topk_symbols)), Nt)
    for _ in range(num_multi):
        if num_hops == 0:
            break
        scores: List[torch.Tensor] = []
        energy_deltas: List[torch.Tensor] = []
        ce_deltas: List[torch.Tensor] = []
        deltas: List[torch.Tensor] = []
        proposed_real: List[torch.Tensor] = []
        proposed_imag: List[torch.Tensor] = []
        for i in range(Nt):
            score_i, energy_delta_i, ce_delta_i, delta_i, real_i, imag_i = best_gray_move(i)
            scores.append(score_i)
            energy_deltas.append(energy_delta_i)
            ce_deltas.append(ce_delta_i)
            deltas.append(delta_i)
            proposed_real.append(real_i)
            proposed_imag.append(imag_i)

        scores_stack = torch.stack(scores, dim=-1)  # (B, K, Nt)
        energy_delta_stack = torch.stack(energy_deltas, dim=-1)
        ce_delta_stack = torch.stack(ce_deltas, dim=-1)
        deltas_stack = torch.stack(deltas, dim=-1)
        proposed_real_stack = torch.stack(proposed_real, dim=-1)
        proposed_imag_stack = torch.stack(proposed_imag, dim=-1)
        selected = scores_stack.topk(num_hops, dim=-1, largest=False).indices
        selected_mask = torch.zeros(B, K, Nt, device=device, dtype=torch.bool).scatter_(dim=-1, index=selected, value=True)

        joint_delta = torch.where(selected_mask, deltas_stack, torch.zeros_like(deltas_stack))
        candidate_x = x + joint_delta
        candidate_residual = residual - torch.einsum("brn,bkn->bkr", H, joint_delta)
        current_energy = (residual.abs() ** 2).sum(dim=-1).real
        candidate_energy = (candidate_residual.abs() ** 2).sum(dim=-1).real
        joint_delta_ce = torch.where(selected_mask, ce_delta_stack, torch.zeros_like(ce_delta_stack)).sum(dim=-1)
        joint_score_delta = (candidate_energy - current_energy) / (Nr * sigma2) + float(posterior_alpha) * joint_delta_ce
        accept = joint_score_delta < 0.0
        candidate_real = torch.where(selected_mask, proposed_real_stack, real_idx)
        candidate_imag = torch.where(selected_mask, proposed_imag_stack, imag_idx)
        x = torch.where(accept[..., None], candidate_x, x)
        residual = torch.where(accept[..., None], candidate_residual, residual)
        real_idx = torch.where(accept[..., None], candidate_real, real_idx)
        imag_idx = torch.where(accept[..., None], candidate_imag, imag_idx)

    for _ in range(max(0, int(sweeps))):
        for i in range(Nt):
            delta_score, _delta_energy, _delta_ce, delta_x, new_ri, new_qi = best_gray_move(i)
            accept = delta_score < 0.0
            accepted_delta = torch.where(accept, delta_x, torch.zeros_like(delta_x))
            x[:, :, i] = x[:, :, i] + accepted_delta
            residual = residual - H[:, None, :, i] * accepted_delta[:, :, None]
            real_idx[:, :, i] = torch.where(accept, new_ri, real_idx[:, :, i])
            imag_idx[:, :, i] = torch.where(accept, new_qi, imag_idx[:, :, i])

    real_bits = level_to_bits(levels[real_idx])
    imag_bits = level_to_bits(levels[imag_idx])
    return torch.cat([real_bits, imag_bits], dim=-1)


