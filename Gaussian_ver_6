#!/usr/bin/env python3
"""
Dynamic Graph-Context Learning-to-Anneal Transformer for hard 32x32 16-QAM MIMO detection.

Finalized toy simulation plan:
- Point-to-point centralized MIMO: y = Hx + n, H in C^{32x32}.
- 16-QAM, 4 coded bits per symbol, 128 hard-decision bits per MIMO vector.
- No channel decoding.
- Main metric: BER.
- Training objective: residual-energy curriculum + bit-wise BCE + list-MAP/K-best posterior teacher + listwise BER-aware ranking.
- Dynamic MIMO context embedding across layers.
- Node embedding: local likelihood terms from z = H^H y and diag(R), R = H^H H.
- Edge embedding: complex pairwise interference terms from R_ij used as attention bias.
- Generation rule: across-symbol autoregressive; within-symbol I/Q-separated direct bit-value mean-field Bernoulli.
- Multiple parallel simulators: fully random valid 16-QAM initial states.
- Per-layer two-phase greedy local search with optional posterior-aware accept score.
- Final candidate selection can use residual energy plus model posterior confidence.
- Baselines: ZF, LMMSE, and exact ML sphere decoding on a compact fixed test subset.

This script is intentionally self-contained. It can be run as a smoke test on CPU, or trained on GPU.
"""

from __future__ import annotations

import argparse
import csv
import math
import os
import random
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
